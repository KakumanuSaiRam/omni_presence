---
import Base from '../../layouts/Base.astro';
import GroupedCards from '../../components/GroupedCards.astro';
import { SITE } from '../../data/site.js';
---
<Base
  title={`Courses & Coaching in Guntur — Tuitions, EAPCET, NEET, POLYCET | ${SITE.name}`}
  description="All courses at Siva Tuitions & Coachings, Guntur: Classes 1–10 tuitions, Intermediate MPC/BiPC, EAPCET (EAMCET), NEET and POLYCET coaching."
>
  <section>
    <div class="wrap">
      <div class="ruled" data-reveal>
        <p class="eyebrow">Courses</p>
        <h1>Coaching &amp; tuitions at Siva Tuitions &amp; Coachings</h1>
      </div>
      <p class="section-intro" data-reveal>
        Grouped by the stage your child is at — school, Intermediate, then the entrance exam
        their stream points to.
      </p>
      <GroupedCards kind="courses" lang="en" />
    </div>
  </section>
</Base>
