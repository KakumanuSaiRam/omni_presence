---
import Base from '../../layouts/Base.astro';
import GroupedCards from '../../components/GroupedCards.astro';
import { SITE, ACADEMIC } from '../../data/site.js';
import { COURSES_LISTING } from '../../data/i18n.js';

const copy = COURSES_LISTING.en;
---
<Base
  title={`Courses & Coaching in Guntur — Tuitions, EAPCET, NEET, POLYCET | ${SITE.name}`}
  description={`All courses at Siva Tuitions & Coachings, Guntur: ${ACADEMIC.school} tuitions, Intermediate MPC/BiPC, EAPCET (EAMCET), NEET and POLYCET coaching.`}
>
  <section>
    <div class="wrap">
      <div class="ruled" data-reveal>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
      </div>
      <p class="section-intro" data-reveal>{copy.intro}</p>
      <GroupedCards kind="courses" lang="en" />
    </div>
  </section>
</Base>
