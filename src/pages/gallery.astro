---
import Base from '../layouts/Base.astro';
import { SITE, GALLERY } from '../data/site.js';
---
<Base
  title="Gallery — Siva Tuitions & Coachings, Guntur"
  description="Photos of Siva Tuitions & Coachings, Pattabhipuram, Guntur."
>
  <section>
    <div class="wrap">
      <h1 style="font-size:clamp(1.8rem,4vw,2.4rem);color:var(--accent-deep)">Gallery</h1>
      <p class="section-intro">Pattabhipuram centre — <a href={SITE.mapsUrl}>more on Google Maps</a>.</p>
      <div class="gallery-grid">
        {GALLERY.map((item) => (
          <figure class="gallery-item">
            <img src={item.src} alt={item.alt} loading="lazy" width="800" height="600" />
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .gallery-grid {
    display: grid; gap: 1.25rem; margin-top: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .gallery-item {
    margin: 0; border: 1px solid var(--border); border-radius: 8px; overflow: hidden;
    background: var(--surface-raised);
  }
  .gallery-item img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; }
  .gallery-item figcaption { padding: 0.65rem 0.9rem; font-size: 0.9rem; color: var(--ink-muted); }
</style>
