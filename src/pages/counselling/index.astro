---
import Base from '../../layouts/Base.astro';
import GroupedCards from '../../components/GroupedCards.astro';
import { SITE } from '../../data/site.js';
---
<Base
  title={`Admission Counselling & Web Options Guidance — Guntur, AP & Telangana | ${SITE.name}`}
  description="EAPCET web options, NEET admission counselling and after-tenth/POLYCET guidance in Guntur — for students across Andhra Pradesh and Telangana."
>
  <section>
    <div class="wrap">
      <div class="ruled" data-reveal>
        <p class="eyebrow">Counselling desk</p>
        <h1>Admission counselling &amp; web options guidance</h1>
      </div>
      <p class="section-intro" data-reveal>
        A rank is only half the journey. The counselling desk turns ranks into seats — grouped
        below by the admission route you are on.
      </p>
      <GroupedCards kind="counselling" lang="en" />
    </div>
  </section>
</Base>
