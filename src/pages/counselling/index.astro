---
import Base from '../../layouts/Base.astro';
import GroupedCards from '../../components/GroupedCards.astro';
import { SITE } from '../../data/site.js';
import { COUNSELLING_LISTING } from '../../data/i18n.js';

const copy = COUNSELLING_LISTING.en;
---
<Base
  title={`Admission Counselling & Web Options Guidance — Guntur, AP & Telangana | ${SITE.name}`}
  description="EAPCET web options, NEET admission counselling and after-tenth/POLYCET guidance in Guntur — for students across Andhra Pradesh and Telangana."
>
  <section>
    <div class="wrap">
      <div class="ruled" data-reveal>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
      </div>
      <p class="section-intro" data-reveal>{copy.intro}</p>
      <GroupedCards kind="counselling" lang="en" />
    </div>
  </section>
</Base>
