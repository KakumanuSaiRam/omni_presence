---
import Base from '../../layouts/Base.astro';
import { SITE, COUNSELLING } from '../../data/site.js';

export function getStaticPaths() {
  return COUNSELLING.map((svc) => ({ params: { slug: svc.slug }, props: { svc } }));
}
const { svc } = Astro.props;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: svc.short,
    name: svc.title,
    description: svc.metaDescription,
    provider: { '@id': `${SITE.url}/#organization` },
    areaServed: ['Guntur', 'Guntur District', 'Andhra Pradesh', 'Telangana'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: svc.faqs.map(({ q, a }) => ({
      '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base title={`${svc.title} | ${SITE.name}`} description={svc.metaDescription} jsonLd={jsonLd}>
  <section>
    <div class="wrap">
      <div class="ruled">
        <p class="eyebrow">Admission counselling</p>
        <h1 style="font-size:clamp(1.7rem,4vw,2.6rem)">{svc.title}</h1>
      </div>
      {svc.body.map((p) => <p style="max-width:68ch;margin-top:1.1rem">{p}</p>)}
      <p style="margin-top:1.5rem;display:flex;gap:1rem;flex-wrap:wrap">
        <a class="btn btn-call" href={`tel:${SITE.phoneHref}`}>Call {SITE.phone}</a>
        <a class="btn btn-wa" href={`https://wa.me/${SITE.whatsapp}`}>WhatsApp us</a>
      </p>
    </div>
  </section>
  <section style="background:#fff;border-block:1px solid var(--rule)">
    <div class="wrap">
      <div class="ruled"><p class="eyebrow">Answers</p><h2>Common questions</h2></div>
      <dl class="faq">
        {svc.faqs.map(({ q, a }) => (<><dt>{q}</dt><dd>{a}</dd></>))}
      </dl>
      <p style="margin-top:1.5rem;font-size:0.95rem">
        People also search for: {svc.queries.join(' · ')}
      </p>
    </div>
  </section>
</Base>
