---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site.js';

const posts = (await getCollection('blog')).sort((a, b) => a.data.title.localeCompare(b.data.title));

const TOPICS = [
  { id: 'after-10th', label: 'After 10th & Intermediate', test: /10th|intermediate|mpc|bipc|hostel|ssc|polycet|polytechnic|iti/i },
  { id: 'eapcet', label: 'EAPCET & engineering', test: /eapcet|eamcet|engineering|jee|normalization|branch selection|rank band|cbse|state board/i },
  { id: 'counselling', label: 'Counselling & web options', test: /web option|counselling|documents checklist|mistake|josaa|ts eamcet/i },
  { id: 'neet', label: 'NEET & pharmacy', test: /neet|pharmacy|pharm\.?d|b\.pharm/i },
  { id: 'graduate', label: 'Graduate admissions', test: /icet|ecet|pg-cet|b\.sc|mba|mca|lateral entry/i },
  { id: 'parents', label: 'Parents & student life', test: /parent|tuition|coaching|scholarship|stress|vidya deevena|visit/i },
];

function topicFor(post) {
  const text = `${post.data.title} ${post.data.description}`;
  for (const topic of TOPICS) {
    if (topic.test.test(text)) return topic;
  }
  return { id: 'more', label: 'More guides' };
}

const grouped = new Map();
for (const post of posts) {
  const topic = topicFor(post);
  if (!grouped.has(topic.id)) grouped.set(topic.id, { ...topic, posts: [] });
  grouped.get(topic.id).posts.push(post);
}

const sectionOrder = [...TOPICS.map((t) => t.id), 'more'].filter((id) => grouped.has(id));
const sections = sectionOrder.map((id) => grouped.get(id));
---

<Base
  title={`Guides — EAPCET, NEET, POLYCET & Admissions in AP | ${SITE.name}`}
  description="Practical guides from Siva Tuitions & Coachings, Guntur: EAPCET web options, NEET counselling, POLYCET after tenth, choosing tuitions and coaching centres in Guntur."
>
  <section class="guides-page">
    <div class="wrap guides-wrap">
      <header class="guides-header">
        <h1>Guides</h1>
        <p class="guides-lede">
          {posts.length} articles on exams, counselling and admissions — from {SITE.name}, Guntur.
        </p>
      </header>

      <nav class="guides-toc" aria-label="Guide topics">
        <p class="guides-toc-label">Jump to</p>
        <ul>
          {sections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.label}</a>
              <span class="guides-toc-count">{section.posts.length}</span>
            </li>
          ))}
        </ul>
      </nav>

      {sections.map((section) => (
        <section class="guides-section" id={section.id}>
          <h2>{section.label}</h2>
          <ul class="guides-list">
            {section.posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  .guides-page {
    padding-block: 2.75rem 4rem;
  }

  .guides-wrap {
    max-width: 36rem;
  }

  .guides-header {
    margin-bottom: 2rem;
  }

  .guides-header h1 {
    color: var(--accent-deep);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.15;
    margin: 0 0 0.5rem;
  }

  .guides-lede {
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
  }

  .guides-toc {
    margin-bottom: 2.5rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface-muted);
  }

  .guides-toc-label {
    margin: 0 0 0.65rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .guides-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .guides-toc li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .guides-toc a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .guides-toc a:hover,
  .guides-toc a:focus-visible {
    color: var(--highlight-deep);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .guides-toc-count {
    flex-shrink: 0;
    font-size: 0.8125rem;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .guides-section {
    scroll-margin-top: 5rem;
  }

  .guides-section + .guides-section {
    margin-top: 2.25rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--border);
  }

  .guides-section h2 {
    font-family: 'Karla', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 0.75rem;
  }

  .guides-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .guides-list li + li {
    margin-top: 0.15rem;
  }

  .guides-list a {
    display: block;
    padding: 0.55rem 0;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }

  .guides-list li:last-child a {
    border-bottom: none;
  }

  .guides-list a:hover,
  .guides-list a:focus-visible {
    color: var(--highlight-deep);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
