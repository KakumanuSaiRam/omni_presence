---
import Base from '../layouts/Base.astro';
import { SITE, DIRECTOR, BRAND, ABOUT, WHY_CHOOSE } from '../data/site.js';
---
<Base
  title="About — Siva Tuitions & Coachings, Guntur"
  description={`${ABOUT.title}. Tuitions, EAPCET/NEET/POLYCET coaching and admission counselling in Pattabhipuram, Guntur.`}
>
  <section>
    <div class="wrap brand-layout">
      <div>
        <p class="eyebrow">Since {SITE.foundingYear}</p>
        <h1 style="font-size:clamp(1.8rem,4vw,2.4rem);color:var(--accent-deep);max-width:28ch">{ABOUT.title}</h1>
        <p style="margin-top:0.75rem;color:var(--highlight);font-weight:600">{BRAND.mission}</p>
      </div>
      <img
        src={BRAND.directorImage}
        alt={`${DIRECTOR.name}, ${DIRECTOR.role}`}
        width="320"
        height="400"
        class="director-portrait"
      />
    </div>
  </section>

  <section class="section-muted">
    <div class="wrap about-copy">
      {ABOUT.paragraphs.map((p) => <p>{p}</p>)}
      <p class="aim"><strong>Our aim:</strong> {ABOUT.aim}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 class="section-heading">Why choose us?</h2>
      <ul class="why-list">
        {WHY_CHOOSE.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-muted">
    <div class="wrap">
      <h2 class="section-heading">{DIRECTOR.name}</h2>
      <p style="color:var(--ink-muted);max-width:50ch">{DIRECTOR.credentials.join(' · ')} — leads coaching and the counselling desk.</p>
      <p style="margin-top:0.75rem"><a href={`/director/${DIRECTOR.slug}/`}>Full profile →</a></p>
      <ul class="values-list">
        {BRAND.values.map((v) => (
          <li><strong>{v.title}</strong> — {v.body}</li>
        ))}
      </ul>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <p><a href="/gallery/">Centre photos →</a> · <a href={`tel:${SITE.phoneHref}`}>Call {SITE.phone}</a></p>
    </div>
  </section>
</Base>

<style>
  .brand-layout {
    display: grid; gap: 2rem; align-items: start;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .brand-layout { grid-template-columns: 1fr minmax(12rem, 16rem); } }
  .director-portrait {
    width: 100%; max-width: 16rem; height: auto; border-radius: 10px;
    border: 1px solid var(--border); object-fit: cover;
  }
  .section-heading { font-size: 1.35rem; color: var(--accent-deep); margin-bottom: 0.5rem; }
  .about-copy { max-width: 58ch; display: grid; gap: 0.85rem; color: var(--ink-muted); }
  .about-copy .aim { color: var(--ink); margin-top: 0.5rem; }
  .why-list {
    margin-top: 0.75rem; padding-left: 1.1rem; max-width: 52ch;
    display: grid; gap: 0.5rem;
  }
  .values-list {
    margin-top: 1.5rem; padding-left: 1.1rem; max-width: 52ch;
    display: grid; gap: 0.65rem; color: var(--ink-muted);
  }
  .values-list strong { color: var(--ink); }
</style>
