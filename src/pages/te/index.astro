---
import Base from '../../layouts/Base.astro';
import HomeContent from '../../components/HomeContent.astro';
import { FAQS_TE } from '../../data/i18n.js';
import { SITE, ACADEMIC } from '../../data/site.js';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'te',
  mainEntity: FAQS_TE.slice(0, 3).map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<Base
  lang="te"
  title="Siva Tuitions & Coachings, గుంటూరు — ట్యూషన్లు, EAPCET/EAMCET, NEET, POLYCET కోచింగ్ మరియు ప్రవేశ కౌన్సెలింగ్"
  description={`పట్టాభిపురం, గుంటూరు: 1–10వ తరగతి–ఇంటర్ ట్యూషన్లు; EAPCET, NEET, POLYCET కోచింగ్; ఆంధ్రప్రదేశ్, తెలంగాణకు వెబ్ ఆప్షన్స్ కౌన్సెలింగ్. ఫోన్ ${SITE.phone}.`}
  jsonLd={[faqSchema]}
>
  <HomeContent lang="te" />
</Base>
