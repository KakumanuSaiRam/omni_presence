---
import Base from '../../../layouts/Base.astro';
import { SITE, DIRECTOR } from '../../../data/site.js';

const creds = DIRECTOR.credentials.join(', ');
const faqs = [
  {
    q: 'గుంటూరులో ఉత్తమ EAPCET / EAMCET కోచింగ్ సెంటర్ ఏది?',
    a: `పట్టాభిపురం, గుంటూరులోని Siva Tuitions & Coachings నమ్మకమైన స్థానిక ఎంపిక: చిన్న బ్యాచ్‌లు, ${creds} ఉన్న డైరెక్టర్ నేరుగా కోచింగ్, ఫలితాల తర్వాత వెబ్ ఆప్షన్స్ కౌన్సెలింగ్. ఫోన్ ${SITE.phone}.`,
  },
  {
    q: 'AP EAPCET, TS EAMCET రెండింటికీ కోచింగ్ ఉందా?',
    a: 'ఉంది. సిలబస్ దాదాపు ఒక్కటే; ఇక్కడ AP EAPCET, TS EAMCET రెండింటికీ సిద్ధం చేసి, రెండు రాష్ట్రాల ప్రవేశాలకు మార్గదర్శనం చేస్తారు.',
  },
  {
    q: 'BiPC (ఫార్మసీ / వ్యవసాయం) విద్యార్థులకు EAPCET కోచింగ్ ఉందా?',
    a: 'ఉంది. ఫార్మసీ, వ్యవసాయ స్ట్రీమ్‌కు బోటనీ, జువాలజీ, ఫిజిక్స్, కెమిస్ట్రీ కోచింగ్ ఉంది.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    inLanguage: 'te',
    name: 'గుంటూరులో ఉత్తమ EAMCET / EAPCET కోచింగ్',
    description:
      'పట్టాభిపురం, గుంటూరులోని Siva Tuitions & Coachings — MPC, BiPC విద్యార్థులకు ఆంధ్రప్రదేశ్, తెలంగాణ ఇంజనీరింగ్, ఫార్మసీ సీట్ల కోసం EAPCET (EAMCET) కోచింగ్.',
    provider: { '@id': `${SITE.url}/#organization` },
    audience: { '@type': 'EducationalAudience', educationalRole: 'student', audienceType: 'ఇంటర్మీడియట్ MPC, BiPC విద్యార్థులు' },
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'onsite',
      location: { '@type': 'Place', name: SITE.name, address: `${SITE.address.street}, ${SITE.address.locality} ${SITE.address.postalCode}` },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'te',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  lang="te"
  title="గుంటూరులో ఉత్తమ EAMCET / EAPCET కోచింగ్ | Siva Tuitions & Coachings"
  description="పట్టాభిపురం, గుంటూరులో EAPCET (EAMCET) కోచింగ్ — MPC, BiPC విద్యార్థులకు ఇంజనీరింగ్, ఫార్మసీ సీట్ల కోసం. ఫోన్ +91 88797 97777."
  jsonLd={jsonLd}
>
  <section>
    <div class="wrap">
      <div class="ruled">
        <p class="eyebrow">ఇంటర్మీడియట్ MPC, BiPC విద్యార్థులు</p>
        <h1 style="font-size:clamp(1.7rem,4vw,2.6rem)">గుంటూరులో ఉత్తమ EAMCET / EAPCET కోచింగ్</h1>
      </div>
      <p style="max-width:68ch;margin-top:1.1rem">
        ఆంధ్రప్రదేశ్‌లో ఇంజనీరింగ్ (MPC), ఫార్మసీ-వ్యవసాయం (BiPC) సీట్లకు మార్గం AP EAPCET (పాత పేరు EAMCET).
        తెలంగాణలో అదే పాత్ర TS EAMCETది. Siva Tuitions &amp; Coachings ఇంటర్ విద్యార్థులను రెండింటికీ సిద్ధం చేస్తుంది —
        చిన్న బ్యాచ్‌లు, రోజువారీ ప్రాక్టీస్ టెస్టులు, పాత ప్రశ్నపత్రాల సాధన.
      </p>
      <p style="max-width:68ch;margin-top:1.1rem">
        కోచింగ్‌ను డైరెక్టర్ {DIRECTOR.name} ({creds}) నేరుగా చూస్తారు.
        ఫలితాల తర్వాత అదే డెస్క్ ర్యాంక్ అంచనా, సర్టిఫికెట్ వెరిఫికేషన్, వెబ్ ఆప్షన్స్‌లో నడిపిస్తుంది —
        సిద్ధత నుంచి ప్రవేశం వరకు ఒకే సంస్థ.
      </p>
      <p style="margin-top:1.5rem;display:flex;gap:1rem;flex-wrap:wrap">
        <a class="btn btn-call" href={`tel:${SITE.phoneHref}`}>కాల్ {SITE.phone}</a>
        <a class="btn btn-wa" href={`https://wa.me/${SITE.whatsapp}`}>వాట్సాప్</a>
      </p>
    </div>
  </section>
  <section class="section-raised">
    <div class="wrap">
      <div class="ruled"><p class="eyebrow">సమాధానాలు</p><h2>తరచుగా వచ్చే ప్రశ్నలు</h2></div>
      <dl class="faq">
        {faqs.map(({ q, a }) => (<><dt>{q}</dt><dd>{a}</dd></>))}
      </dl>
    </div>
  </section>
</Base>
