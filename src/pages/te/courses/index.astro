---
import Base from '../../../layouts/Base.astro';
import GroupedCards from '../../../components/GroupedCards.astro';
import { COURSES_LISTING } from '../../../data/i18n.js';

const copy = COURSES_LISTING.te;
---
<Base
  lang="te"
  title="కోర్సులు & కోచింగ్ — ట్యూషన్లు, EAPCET, NEET, POLYCET | Siva Tuitions, గుంటూరు"
  description="Siva Tuitions & Coachings, గుంటూరు: 6–10వ తరగతి ట్యూషన్లు, ఇంటర్ MPC/BiPC, EAPCET (EAMCET), NEET, POLYCET కోచింగ్."
>
  <section>
    <div class="wrap">
      <div class="ruled" data-reveal>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
      </div>
      <p class="section-intro" data-reveal>{copy.intro}</p>
      <GroupedCards kind="courses" lang="te" />
    </div>
  </section>
</Base>
