---
import Base from '../../layouts/Base.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { SITE } from '../../data/site.js';

const addressLine = `${SITE.address.street}, ${SITE.address.locality}, ${SITE.address.region} ${SITE.address.postalCode}`;
---
<Base
  lang="te"
  title={`సంప్రదించండి ${SITE.name} — పట్టాభిపురం, గుంటూరు | ఫోన్, వాట్సాప్, దారి`}
  description={`Siva Tuitions & Coachings: ${SITE.phone}, ${SITE.email}. చిరునామా: ${SITE.address.street}, గుంటూరు ${SITE.address.postalCode}.`}
>
  <section id="enquire">
    <div class="wrap">
      <div class="ruled">
        <p class="eyebrow">తల్లిదండ్రులు & విద్యార్థులు</p>
        <h1>మీ ప్రశ్న అడగండి</h1>
      </div>
      <p class="section-intro" style="max-width:50ch">
        మీ ప్రశ్న రాయండి — మొబైల్ నంబర్ ఇస్తే నేరుగా {SITE.phone} వాట్సాప్‌కు వెళ్తుంది.
        ఈమెయిల్ కూడా పంపవచ్చు, కానీ సమాధానం కొంచెం ఆలస్యం అవుతుంది.
      </p>
      <EnquiryForm id="contact-enquiry" lang="te" />
    </div>
  </section>

  <section class="section-muted">
    <div class="wrap">
      <div class="ruled">
        <p class="eyebrow">రండి · కాల్ · వాట్సాప్</p>
        <h2>Siva Tuitions &amp; Coachingsను సంప్రదించండి</h2>
      </div>

      <div class="quick-btns" style="margin-top:1.25rem">
        <a class="btn btn-call" href={`tel:${SITE.phoneHref}`}>ఇప్పుడే కాల్ చేయండి</a>
        <a class="btn btn-wa" href={`https://wa.me/${SITE.whatsapp}`} style="color:var(--accent-deep);border-color:var(--accent)">వాట్సాప్</a>
        <a class="btn btn-wa" href={SITE.mapsUrl} style="color:var(--accent-deep);border-color:var(--accent)">దారి చూపించండి</a>
      </div>

      <div class="grid" style="margin-top:1.75rem">
        <div class="card">
          <h3>📍 చిరునామా</h3>
          <p>{addressLine}</p>
          <p style="margin-top:0.6rem"><a href={SITE.mapsUrl}>గూగుల్ మ్యాప్స్ →</a></p>
        </div>
        <div class="card">
          <h3>📞 ఫోన్, వాట్సాప్</h3>
          <p><a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a></p>
          <p style="margin-top:0.6rem"><a href={`https://wa.me/${SITE.whatsapp}`}>వాట్సాప్ సందేశం →</a></p>
        </div>
        <div class="card">
          <h3>📧 ఈమెయిల్, యాప్</h3>
          <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          <p style="margin-top:0.6rem"><a href={SITE.playStoreUrl}>ఆండ్రాయిడ్ యాప్ →</a></p>
          <p style="margin-top:0.6rem"><a href="/te/resources/">అధికారిక పరీక్ష లింకులు →</a></p>
        </div>
      </div>

      <p style="margin-top:1.5rem;max-width:65ch;color:var(--ink-muted)">
        పని వేళలు: సోమవారం–శనివారం, ఉదయం 6:00 – రాత్రి 9:00; ఆదివారం, ఉదయం 10:00 – మధ్యాహ్నం 2:00. EAPCET, NEET, POLYCET కౌన్సెలింగ్ సీజన్‌లో
        ఆంధ్రప్రదేశ్, తెలంగాణ విద్యార్థులకు ఫోన్, వాట్సాప్ కౌన్సెలింగ్ కూడా ఉంటుంది. హైదరాబాద్ లేదా విజయవాడలో శాఖ లేదు —
        కేంద్రం పట్టాభిపురం, గుంటూరు మాత్రమే.
      </p>
    </div>
  </section>
</Base>

<style>
  .quick-btns { display: flex; gap: 0.75rem; flex-wrap: wrap; }
</style>
