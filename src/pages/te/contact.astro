---
import Base from '../../layouts/Base.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import MapsIcon from '../../components/MapsIcon.astro';
import { SITE } from '../../data/site.js';
import { UI } from '../../data/i18n.js';

const ui = UI.te;

const addressLine = `${SITE.address.street}, ${SITE.address.locality}, ${SITE.address.region} ${SITE.address.postalCode}`;
const waHref = `https://wa.me/${SITE.whatsapp}`;
---
<Base
  lang="te"
  title={`సంప్రదించండి ${SITE.name} — పట్టాభిపురం, గుంటూరు | ఫోన్, వాట్సాప్, దారి`}
  description={`Siva Tuitions & Coachings: ${SITE.phone}, ${SITE.email}. చిరునామా: ${SITE.address.street}, గుంటూరు ${SITE.address.postalCode}.`}
>
  <section class="hero-band">
    <div class="wrap">
      <p class="eyebrow">తల్లిదండ్రులు &amp; విద్యార్థులు</p>
      <h1>మీ ప్రశ్న అడగండి</h1>
      <p class="hero-sub">
        మీ ప్రశ్న రాయండి — మొబైల్ నంబర్ ఇస్తే నేరుగా {SITE.phone} వాట్సాప్‌కు వెళ్తుంది.
        ఈమెయిల్ కూడా పంపవచ్చు, కానీ సమాధానం కొంచెం ఆలస్యం అవుతుంది.
      </p>
      <p class="quick-btns">
        <a class="btn btn-call" href={`tel:${SITE.phoneHref}`}>ఇప్పుడే కాల్ చేయండి</a>
        <a class="btn btn-ghost" href={waHref}>వాట్సాప్</a>
        <a class="btn btn-ghost btn-icon" href={SITE.mapsDirectionsUrl}>
          <MapsIcon />
          {ui.maps}
        </a>
      </p>
    </div>
  </section>

  <section id="enquire">
    <div class="wrap contact-layout">
      <div data-reveal>
        <h2 class="lbl">వివరాలు పంపండి</h2>
        <EnquiryForm id="contact-enquiry" lang="te" />
      </div>

      <aside data-reveal data-reveal-delay="1">
        <h2 class="lbl">నేరుగా సంప్రదించండి</h2>
        <dl class="detail-list">
          <div>
            <dt>చిరునామా</dt>
            <dd><a href={SITE.mapsDirectionsUrl}>{addressLine}</a><br /><a href={SITE.mapsUrl}>గూగుల్ మ్యాప్స్ &rarr;</a></dd>
          </div>
          <div>
            <dt>ఫోన్</dt>
            <dd><a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a> · <a href={waHref}>వాట్సాప్ &rarr;</a></dd>
          </div>
          <div>
            <dt>ఈమెయిల్</dt>
            <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
          </div>
          <div>
            <dt>యాప్</dt>
            <dd><a href={SITE.playStoreUrl}>ఆండ్రాయిడ్ యాప్ &rarr;</a></dd>
          </div>
          <div>
            <dt>పని వేళలు</dt>
            <dd>సోమవారం–శనివారం, ఉదయం 6:00 – రాత్రి 9:00; ఆదివారం, ఉదయం 10:00 – మధ్యాహ్నం 2:00.</dd>
          </div>
        </dl>

        <div class="panel" style="margin-top:1.5rem">
          <p class="panel-label">కౌన్సెలింగ్ సీజన్</p>
          <p style="color:var(--ink-muted);margin-top:0.3rem">
            EAPCET, NEET, POLYCET కౌన్సెలింగ్ సీజన్‌లో ఆంధ్రప్రదేశ్, తెలంగాణ విద్యార్థులకు ఫోన్, వాట్సాప్
            కౌన్సెలింగ్ కూడా ఉంటుంది. హైదరాబాద్ లేదా విజయవాడలో శాఖ లేదు — కేంద్రం పట్టాభిపురం, గుంటూరు మాత్రమే.
          </p>
          <p style="margin-top:0.6rem"><a href="/te/resources/">ముఖ్య లింకులు &amp; స్కాలర్‌షిప్‌లు &rarr;</a></p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .hero-band {
    background: linear-gradient(180deg, var(--surface-muted), var(--surface));
    border-bottom: 1px solid var(--border);
  }
  .hero-band h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); color: var(--accent-deep); margin-top: 0.3rem; }
  .hero-sub { margin-top: 0.7rem; color: var(--ink-muted); max-width: 52ch; }
  .quick-btns { margin-top: 1.25rem; display: flex; gap: 0.65rem; flex-wrap: wrap; }

  .lbl {
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--highlight-deep);
    margin-bottom: 0.9rem;
  }
  .contact-layout { display: grid; gap: 2.5rem; align-items: start; grid-template-columns: 1fr; }
  @media (min-width: 820px) { .contact-layout { grid-template-columns: 1.1fr 0.9fr; gap: 3rem; } }
</style>
