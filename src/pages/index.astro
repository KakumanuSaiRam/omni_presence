---
import Base from '../layouts/Base.astro';
import HomeContent from '../components/HomeContent.astro';
import { GLOBAL_FAQS } from '../data/site.js';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: GLOBAL_FAQS.slice(0, 3).map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<Base
  title="Siva Tuitions & Coachings, Guntur — Tuitions, EAPCET, NEET, POLYCET Coaching & Admission Counselling"
  description="Siva Tuitions & Coachings, Pattabhipuram, Guntur: tuitions Class 6–Intermediate, EAPCET/NEET/POLYCET coaching, and admission counselling for AP & Telangana. Call +91 88797 97777."
  jsonLd={[faqSchema]}
>
  <HomeContent lang="en" />
</Base>
