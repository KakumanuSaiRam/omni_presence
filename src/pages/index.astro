---
import Base from '../layouts/Base.astro';
import Illustration from '../components/Illustration.astro';
import { SITE, DIRECTOR, COURSES, COUNSELLING, GLOBAL_FAQS } from '../data/site.js';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: GLOBAL_FAQS.slice(0, 2).map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const TUITION_SLUGS = ['school-tuitions-guntur', 'tenth-class-tuitions-guntur', 'intermediate-tuitions-guntur'];
const ENTRANCE_SLUGS = ['eamcet-eapcet-coaching-guntur', 'neet-coaching-guntur', 'polytechnic-polycet-coaching-guntur', 'short-term-crash-coaching-guntur'];

const SERVICE_SECTIONS = [
  { id: 'tuitions', title: 'Tuitions', items: TUITION_SLUGS.map((s) => COURSES.find((c) => c.slug === s)).filter(Boolean), muted: false },
  { id: 'coaching', title: 'Entrance coaching', items: ENTRANCE_SLUGS.map((s) => COURSES.find((c) => c.slug === s)).filter(Boolean), muted: true },
  { id: 'counselling', title: 'Admission counselling', items: COUNSELLING, muted: false, isCounselling: true },
];
---
<Base
  title="Siva Tuitions & Coachings, Guntur — Best Tuitions, EAPCET/EAMCET, NEET & POLYCET Coaching and Admission Counselling"
  description="Siva Tuitions & Coachings, Pattabhipuram, Guntur: tuitions for Classes 1–10 and Intermediate, EAPCET (EAMCET), NEET and POLYCET coaching, plus web options and admission counselling for Andhra Pradesh and Telangana. Call +91 88797 97777."
  jsonLd={[faqSchema]}
>
  <section class="hero">
    <div class="wrap hero-split">
      <div>
        <p class="eyebrow">Pattabhipuram · Guntur · Since {SITE.foundingYear}</p>
        <h1 class="hero-title">From Class 1 to your college seat.</h1>
        <p class="hero-lead">Tuitions, EAPCET/NEET/POLYCET coaching, and admission counselling — one centre.</p>
        <p class="hero-actions">
          <a class="btn btn-call" href={`tel:${SITE.phoneHref}`}>Call {SITE.phone}</a>
          <a class="btn btn-wa" href={`https://wa.me/${SITE.whatsapp}`}>WhatsApp</a>
        </p>
      </div>
      <Illustration src="/illustrations/students-classroom.svg" alt="" class="hero-art" />
    </div>
  </section>

  {SERVICE_SECTIONS.map((section) => (
    <section id={section.id} class={section.muted ? 'section-muted' : ''}>
      <div class="wrap">
        <div class={section.isCounselling ? 'split-art' : ''}>
          <div>
            <h2 class="section-heading">{section.title}</h2>
            <ul class="link-list">
              {section.items.map((item) => (
                <li>
                  <a href={section.isCounselling ? `/counselling/${item.slug}/` : `/courses/${item.slug}/`}>
                    {item.short}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          {section.isCounselling && (
            <Illustration src="/illustrations/counselling-desk.svg" alt="" class="side-art" />
          )}
        </div>
      </div>
    </section>
  ))}

  <section class="section-muted">
    <div class="wrap split-art">
      <div>
        <h2 class="section-heading">Director: {DIRECTOR.name}</h2>
        <p style="max-width:60ch;color:var(--ink-muted)">
          {DIRECTOR.honorific} {DIRECTOR.name} — <strong style="color:var(--ink)">{DIRECTOR.credentials.join(', ')}</strong> —
          founded the institute and personally leads both the coaching and the admission-counselling
          desk. <a href={`/director/${DIRECTOR.slug}/`}>Read his full profile →</a>
        </p>
      </div>
      <Illustration src="/illustrations/graduation-joy.svg" alt="" class="side-art side-art-sm" />
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="contact-strip">
        <div>
          <h2 style="font-size:1.25rem">Talk to us</h2>
          <p>{SITE.address.locality}, {SITE.address.postalCode}</p>
        </div>
        <a class="btn btn-call" href={`tel:${SITE.phoneHref}`} style="background:#fff;color:var(--accent-deep)">Call {SITE.phone}</a>
      </div>
    </div>
  </section>

  <section class="section-muted" style="padding-top:1.5rem;padding-bottom:2rem">
    <div class="wrap">
      <h2 class="section-heading">Common questions</h2>
      <dl class="faq faq-compact">
        {GLOBAL_FAQS.slice(0, 2).map(({ q, a }) => (<><dt>{q}</dt><dd>{a}</dd></>))}
      </dl>
      <p style="margin-top:1rem"><a href="/faq/">All FAQs →</a></p>
    </div>
  </section>
</Base>

<style>
  .hero-split {
    display: grid; gap: 1.5rem; align-items: center;
    padding: 2.5rem 1.25rem; grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .hero-split { grid-template-columns: 1.1fr 0.9fr; } }
  .hero-title {
    font-size: clamp(2rem, 5vw, 3rem); color: var(--accent-deep);
    max-width: 18ch; margin: 0.4rem 0 0.75rem;
  }
  .hero-lead { color: var(--ink-muted); max-width: 38ch; }
  .hero-actions { margin-top: 1.25rem; display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .hero-art { max-width: 22rem; margin: 0 auto; }
  .section-heading {
    font-size: 1.35rem; color: var(--accent-deep); margin-bottom: 0.75rem;
    padding-bottom: 0.4rem; border-bottom: 1px solid var(--border);
  }
  .link-list {
    list-style: none; padding: 0; display: grid;
    gap: 0.35rem 1.5rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .link-list a {
    display: block; padding: 0.55rem 0; text-decoration: none;
    font-weight: 600; color: var(--ink);
    border-bottom: 1px solid transparent;
  }
  .link-list a:hover { color: var(--accent); border-bottom-color: var(--accent-soft); }
  .faq-compact dt { margin-top: 1rem; }
  .faq-compact dd { font-size: 0.98rem; color: var(--ink-muted); }
  .split-art { display: grid; gap: 1.5rem; align-items: center; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .split-art { grid-template-columns: 1.3fr 0.7fr; } }
  .side-art { max-width: 17rem; margin: 0 auto; }
  .side-art-sm { max-width: 13rem; }
</style>
