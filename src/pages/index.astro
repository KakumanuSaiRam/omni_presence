---
import Base from '../layouts/Base.astro';
import Illustration from '../components/Illustration.astro';
import {
  SITE,
  DIRECTOR,
  BRAND,
  HOME,
  ACADEMIC_TUITIONS,
  COMPETITIVE_COACHING,
  COUNSELLING_HUB,
  WHY_CHOOSE,
  ABOUT,
  GALLERY,
  SOCIAL_ACTIVITIES,
  GLOBAL_FAQS,
} from '../data/site.js';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: GLOBAL_FAQS.slice(0, 2).map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const addressLine = `${SITE.address.street}, ${SITE.address.locality}, ${SITE.address.region} ${SITE.address.postalCode}`;
---
<Base
  title="Siva Tuitions & Coachings, Guntur — Tuitions, EAPCET, NEET, POLYCET Coaching & Admission Counselling"
  description="Siva Tuitions & Coachings, Pattabhipuram, Guntur: tuitions 6th–Intermediate, EAPCET/NEET/POLYCET coaching, and admission counselling for AP & Telangana. Call +91 88797 97777."
  jsonLd={[faqSchema]}
>
  <section class="hero">
    <div class="wrap hero-split">
      <div>
        <p class="eyebrow">Pattabhipuram · Guntur · Since {SITE.foundingYear}</p>
        <h1 class="hero-title">{SITE.name}</h1>
        <p class="hero-sub">{HOME.subline}</p>
        <p class="hero-te" lang="te">{HOME.teluguTagline}</p>
        <p class="hero-actions">
          <a class="btn btn-call" href={`tel:${SITE.phoneHref}`}>Call {SITE.phone}</a>
          <a class="btn btn-wa" href={`https://wa.me/${SITE.whatsapp}`}>WhatsApp</a>
          <a class="btn btn-wa" href={SITE.mapsUrl}>Directions</a>
        </p>
      </div>
      <Illustration src={COMPETITIVE_COACHING.illustration} alt="Students preparing for competitive entrance exams" class="hero-art" />
    </div>
  </section>

  <section class="section-raised">
    <div class="wrap">
      <p class="eyebrow" lang="te">{HOME.servicesTitleTe}</p>
      <div class="service-nav">
        <a href="#tuitions" class="service-pill">📚 Academic Tuitions</a>
        <a href="#coaching" class="service-pill">🎯 Competitive Coaching</a>
        <a href="#counselling" class="service-pill service-pill--accent">🎓 Admissions & Counselling</a>
      </div>
      <p class="contact-line">
        <a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a>
        · {SITE.address.locality}, {SITE.address.postalCode}
      </p>
    </div>
  </section>

  <section id="tuitions">
    <div class="wrap split-section">
      <div>
        <h2 class="section-heading">{ACADEMIC_TUITIONS.title}</h2>
        <p class="section-lead">{ACADEMIC_TUITIONS.telugu}</p>
        <p class="section-meta">Classes {ACADEMIC_TUITIONS.classes}</p>
        <div class="tag-group">
          <span class="tag-label">Up to 10th</span>
          {ACADEMIC_TUITIONS.boards10.map((b) => <span class="tag">{b}</span>)}
        </div>
        <div class="tag-group">
          <span class="tag-label">Intermediate</span>
          {ACADEMIC_TUITIONS.inter.map((b) => <span class="tag">{b}</span>)}
        </div>
        <div class="tag-group">
          <span class="tag-label" lang="te">ప్రత్యేకంగా</span>
          {ACADEMIC_TUITIONS.highlightsTe.map((b) => <span class="tag">{b}</span>)}
        </div>
        <p class="section-links">
          <a href="/courses/school-tuitions-guntur/">Classes 1–10 →</a>
          · <a href="/courses/intermediate-tuitions-guntur/">Intermediate →</a>
        </p>
      </div>
      <Illustration src={ACADEMIC_TUITIONS.illustration} alt="Students in tuition class" class="section-art" />
    </div>
  </section>

  <section id="coaching" class="section-muted">
    <div class="wrap split-section split-reverse">
      <Illustration src="/illustrations/exam-prep.svg" alt="Entrance exam preparation" class="section-art" />
      <div>
        <h2 class="section-heading">{COMPETITIVE_COACHING.title}</h2>
        <p class="section-lead">{COMPETITIVE_COACHING.intro}</p>
        <div class="tag-group">
          {COMPETITIVE_COACHING.programs.map((p) => <span class="tag">{p}</span>)}
        </div>
        <p class="focus-line">
          {COMPETITIVE_COACHING.focus.join(' · ')}
        </p>
        <p class="section-links">
          <a href="/courses/eamcet-eapcet-coaching-guntur/">EAPCET →</a>
          · <a href="/courses/neet-coaching-guntur/">NEET →</a>
          · <a href="/courses/short-term-crash-coaching-guntur/">Short-term →</a>
        </p>
      </div>
    </div>
  </section>

  <section id="counselling" class="counselling-feature">
    <div class="wrap">
      <div class="split-section">
        <div>
          <p class="eyebrow">Our key strength</p>
          <h2 class="section-heading">{COUNSELLING_HUB.title}</h2>
          <p class="section-lead" lang="te">{COUNSELLING_HUB.telugu}</p>
          <p class="section-meta">{COUNSELLING_HUB.intro}</p>
          <p class="objective">{COUNSELLING_HUB.objective}</p>
        </div>
        <Illustration src={COUNSELLING_HUB.illustration} alt="Admission counselling guidance" class="section-art" />
      </div>
      <div class="counselling-grid">
        <div>
          <h3>Entrance exams</h3>
          <ul class="chip-list">
            {COUNSELLING_HUB.entranceExams.map((e) => <li>{e}</li>)}
          </ul>
        </div>
        <div>
          <h3>Courses & admissions</h3>
          <ul class="chip-list">
            {COUNSELLING_HUB.courses.map((c) => <li>{c}</li>)}
          </ul>
        </div>
        <div>
          <h3>Counselling services</h3>
          <ul class="chip-list">
            {COUNSELLING_HUB.services.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </div>
      <p class="section-links" style="margin-top:1.25rem">
        <a href="/counselling/">All counselling services →</a>
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 class="section-heading">Why choose us?</h2>
      <ul class="why-grid">
        {WHY_CHOOSE.map((point) => (
          <li><span class="why-mark">✓</span>{point}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-muted">
    <div class="wrap about-block">
      <img
        src={BRAND.directorImage}
        alt={`${DIRECTOR.name}, ${DIRECTOR.role}`}
        width="140"
        height="175"
        class="about-photo"
        loading="lazy"
      />
      <div>
        <h2 class="section-heading">{ABOUT.title}</h2>
        <p class="about-text">{ABOUT.paragraphs[0]}</p>
        <p class="about-text">{ABOUT.aim}</p>
        <p class="section-links"><a href="/brand/">Full about page →</a></p>
      </div>
    </div>
  </section>

  <section class="section-raised">
    <div class="wrap">
      <h2 class="section-heading" style="margin-bottom:1rem">At our centre</h2>
      <div class="photo-strip">
        {GALLERY.slice(0, 4).map((photo) => (
          <figure class="photo-thumb">
            <img src={photo.src} alt={photo.alt} width="200" height="140" loading="lazy" />
          </figure>
        ))}
      </div>
      <p class="section-links"><a href="/gallery/">Full gallery →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 class="section-heading">{SOCIAL_ACTIVITIES.title}</h2>
      <p class="section-lead">{SOCIAL_ACTIVITIES.intro}</p>
      <div class="photo-strip">
        {SOCIAL_ACTIVITIES.photos.slice(0, 4).map((photo) => (
          <figure class="photo-thumb">
            <img src={photo.src} alt={photo.alt} width="200" height="140" loading="lazy" />
          </figure>
        ))}
      </div>
      <p class="section-links"><a href="/gallery/#social">All social activities →</a></p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="contact-strip">
        <div>
          <h2 style="font-size:1.25rem">{SITE.name}</h2>
          <p>{addressLine}</p>
          <p style="margin-top:0.35rem;opacity:0.9">
            <a href={`tel:${SITE.phoneHref}`} style="color:inherit">{SITE.phone}</a>
            · <a href={`mailto:${SITE.email}`} style="color:inherit">{SITE.email}</a>
          </p>
        </div>
        <div class="quick-btns">
          <a class="btn btn-call" href={`tel:${SITE.phoneHref}`} style="background:#fff;color:var(--accent-deep)">Call Now</a>
          <a class="btn btn-wa" href={`https://wa.me/${SITE.whatsapp}`} style="color:#fff;border-color:rgba(255,255,255,0.6)">WhatsApp</a>
          <a class="btn btn-wa" href={SITE.mapsUrl} style="color:#fff;border-color:rgba(255,255,255,0.6)">Directions</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-muted" style="padding-top:1.5rem;padding-bottom:2rem">
    <div class="wrap">
      <h2 class="section-heading">Common questions</h2>
      <dl class="faq faq-compact">
        {GLOBAL_FAQS.slice(0, 2).map(({ q, a }) => (<><dt>{q}</dt><dd>{a}</dd></>))}
      </dl>
      <p style="margin-top:1rem"><a href="/faq/">All FAQs →</a></p>
    </div>
  </section>
</Base>

<style>
  .hero-split {
    display: grid; gap: 1.5rem; align-items: center;
    padding: 2.5rem 1.25rem; grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .hero-split { grid-template-columns: 1.05fr 0.95fr; } }
  .hero-title {
    font-size: clamp(1.75rem, 4.5vw, 2.6rem); color: var(--accent-deep);
    margin: 0.35rem 0 0.5rem;
  }
  .hero-sub { font-weight: 600; color: var(--highlight); max-width: 42ch; font-size: 0.98rem; }
  .hero-te { color: var(--ink-muted); max-width: 44ch; margin-top: 0.65rem; font-size: 1.05rem; }
  .hero-actions { margin-top: 1.25rem; display: flex; gap: 0.65rem; flex-wrap: wrap; }
  .hero-art { max-width: 24rem; margin: 0 auto; }

  .service-nav {
    display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 0.75rem;
  }
  .service-pill {
    padding: 0.65rem 1rem; border-radius: 8px; text-decoration: none;
    font-weight: 700; color: var(--ink); background: var(--surface-muted);
    border: 1px solid var(--border); font-size: 0.95rem;
  }
  .service-pill:hover { border-color: var(--accent); background: var(--surface-raised); }
  .service-pill--accent { background: var(--surface-accent); border-color: var(--accent-soft); }
  .contact-line { margin-top: 1rem; color: var(--ink-muted); font-size: 0.95rem; }

  .split-section {
    display: grid; gap: 1.75rem; align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .split-section { grid-template-columns: 1fr 1fr; }
    .split-reverse .section-art { order: -1; }
  }
  .section-art { max-width: 20rem; margin: 0 auto; }
  .section-heading {
    font-size: 1.35rem; color: var(--accent-deep); margin-bottom: 0.5rem;
  }
  .section-lead { color: var(--ink-muted); max-width: 46ch; }
  .section-meta { margin-top: 0.5rem; font-size: 0.95rem; color: var(--ink); font-weight: 600; }
  .section-links { margin-top: 1rem; font-weight: 600; }
  .tag-group { margin-top: 0.85rem; display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .tag-label { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--highlight); width: 100%; }
  .tag {
    display: inline-block; padding: 0.25rem 0.6rem; border-radius: 999px;
    background: var(--surface-muted); border: 1px solid var(--border);
    font-size: 0.88rem; color: var(--ink);
  }
  .focus-line { margin-top: 0.85rem; font-size: 0.92rem; color: var(--highlight); font-weight: 600; }

  .counselling-feature {
    background: linear-gradient(180deg, var(--surface-accent) 0%, var(--surface) 100%);
    border-block: 1px solid var(--border);
  }
  .objective {
    margin-top: 0.85rem; padding: 0.75rem 1rem; border-radius: 8px;
    background: var(--surface-raised); border-left: 3px solid var(--highlight);
    font-weight: 700; color: var(--accent-deep); max-width: 48ch;
  }
  .counselling-grid {
    margin-top: 1.75rem; display: grid; gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .counselling-grid h3 { font-size: 1rem; color: var(--accent-deep); margin-bottom: 0.5rem; }
  .chip-list {
    list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem;
  }
  .chip-list li {
    font-size: 0.85rem; padding: 0.2rem 0.55rem; border-radius: 6px;
    background: var(--surface-muted); border: 1px solid var(--border);
  }

  .why-grid {
    list-style: none; padding: 0; margin-top: 0.75rem;
    display: grid; gap: 0.65rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .why-grid li { display: flex; gap: 0.5rem; align-items: flex-start; font-weight: 600; }
  .why-mark { color: var(--highlight); flex-shrink: 0; }

  .about-block {
    display: grid; gap: 1.5rem; align-items: start;
    grid-template-columns: auto 1fr;
  }
  @media (max-width: 520px) { .about-block { grid-template-columns: 1fr; } }
  .about-photo {
    width: 8.75rem; height: auto; border-radius: 10px;
    border: 1px solid var(--border); object-fit: cover;
  }
  .about-text { color: var(--ink-muted); max-width: 52ch; margin-top: 0.5rem; }

  .photo-strip {
    display: grid; gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
  }
  .photo-thumb { margin: 0; overflow: hidden; border-radius: 8px; border: 1px solid var(--border); }
  .photo-thumb img { width: 100%; height: 7rem; object-fit: cover; display: block; }

  .quick-btns { display: flex; gap: 0.65rem; flex-wrap: wrap; }
  .faq-compact dt { margin-top: 1rem; }
  .faq-compact dd { font-size: 0.98rem; color: var(--ink-muted); }
</style>
