---
import { SITE, DIRECTOR, TE_ALTERNATES, EN_ALTERNATES, normalizePath } from '../data/site.js';
import { NAV, UI } from '../data/i18n.js';
import { ogImagePath } from '../data/og-pages.js';
import EnquiryWidget from '../components/EnquiryWidget.astro';
import MapsIcon from '../components/MapsIcon.astro';

const { title, description, jsonLd = [], noOrgSchema = false, lang = 'en' } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const path = normalizePath(Astro.url.pathname);
const ogImage = new URL(ogImagePath(path), SITE.url).href;
const isTe = path === '/te/' || path.startsWith('/te/');
const enPath = isTe ? (EN_ALTERNATES[path] ?? '/') : path;
const tePath = TE_ALTERNATES[enPath] ?? '/te/';
const hasHreflang = Boolean(TE_ALTERNATES[enPath]);
const langHref = isTe ? enPath : tePath;
const langLabel = isTe ? 'English' : 'తెలుగు';

const locale = isTe ? 'te' : 'en';
const navItems = NAV[locale];
const ui = UI[locale];
const homeHref = isTe ? '/te/' : '/';
const galleryHref = isTe ? '/te/gallery/' : '/gallery/';
const socialHref = `${galleryHref}#social`;
const resourcesHref = isTe ? '/te/resources/' : '/resources/';
const askHref = isTe ? '/te/contact/#enquire' : '/contact/#enquire';
const aboutHref = isTe ? '/te/about/' : '/brand/';
const faqHref = isTe ? '/te/faq/' : '/faq/';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['EducationalOrganization', 'LocalBusiness'],
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  alternateName: ['Siva Tuitions', 'Siva Tuitions and Coachings Guntur'],
  inLanguage: lang,
  url: SITE.url,
  telephone: SITE.phone,
  email: SITE.email,
  foundingDate: String(SITE.foundingYear),
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lng },
  openingHours: SITE.hours,
  areaServed: ['Guntur', 'Guntur District', 'Andhra Pradesh', 'Telangana'],
  founder: {
    '@type': 'Person',
    '@id': `${SITE.url}/director/${DIRECTOR.slug}/#person`,
    name: DIRECTOR.name,
    jobTitle: DIRECTOR.role,
    url: `${SITE.url}/director/${DIRECTOR.slug}/`,
  },
  sameAs: [
    SITE.playStoreUrl,
    SITE.mapsUrl,
    SITE.mapsDirectionsUrl,
    'https://www.urbanpro.com/guntur/siva-tuitions-gujjanagundla/31503988',
    'https://www.sulekha.com/profile/siva-tuitions-at-agraharam-guntur',
  ],
  knowsAbout: [
    'EAPCET coaching Guntur',
    'EAMCET coaching Guntur',
    'NEET coaching Guntur',
    'POLYCET coaching Guntur',
    'web options counselling',
    'Intermediate tuitions Guntur',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: SITE.phone,
    contactType: 'customer service',
    areaServed: 'IN',
    availableLanguage: ['en', 'te'],
  },
};

const schemas = noOrgSchema ? jsonLd : [orgSchema, ...jsonLd];

const FONT_LATIN =
  'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Karla:wght@400;500;700&display=swap';
const FONT_TE =
  'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Karla:wght@400;500;700&family=Noto+Sans+Telugu:wght@400;500;700&display=swap';
const FONT_TOGGLE =
  'https://fonts.googleapis.com/css2?family=Noto+Sans+Telugu:wght@700&text=%E0%B0%A4%E0%B1%86%E0%B0%B2%E0%B1%81%E0%B0%97%E0%B1%81&display=swap';
---
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {hasHreflang && (
    <>
      <link rel="alternate" hreflang="en" href={new URL(enPath, SITE.url).href} />
      <link rel="alternate" hreflang="te" href={new URL(TE_ALTERNATES[enPath], SITE.url).href} />
      <link rel="alternate" hreflang="x-default" href={new URL(enPath, SITE.url).href} />
    </>
  )}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <meta name="geo.region" content="IN-AP" />
  <meta name="geo.placename" content="Guntur" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {isTe ? (
    <link rel="stylesheet" href={FONT_TE} media="print" onload="this.media='all'" />
  ) : (
    <>
      <link rel="stylesheet" href={FONT_LATIN} media="print" onload="this.media='all'" />
      <link rel="stylesheet" href={FONT_TOGGLE} media="print" onload="this.media='all'" />
    </>
  )}
  <noscript>
    <link rel="stylesheet" href={isTe ? FONT_TE : FONT_LATIN} />
  </noscript>
  {schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <style is:global>
    /* Palette drawn from the logo: navy crest, orange wordmark. Surfaces are a
       light blue tint, accents a light orange, so the mark sits naturally. */
    :root {
      --surface: #f5f9fd;
      --surface-raised: #ffffff;
      --surface-muted: #e9f1fb;
      --surface-accent: #fff4e6;
      --ink: #1a2340;
      --ink-muted: #5a6580;
      --accent: #1f2368;
      --accent-deep: #151a4d;
      --accent-soft: #c3d9f2;
      --highlight: #e8821a;
      --highlight-deep: #c26a10;
      --highlight-soft: #ffd9a8;
      --border: rgba(31, 35, 104, 0.12);
      --shadow: rgba(31, 35, 104, 0.1);
      --max: 68rem;
      --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    * { box-sizing: border-box; margin: 0; }
    /* A `display` rule on a component beats the UA's [hidden] { display: none },
       so restate it with priority. */
    [hidden] { display: none !important; }
    html { scroll-behavior: smooth; overflow-x: clip; }
    img, svg, video { max-width: 100%; height: auto; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    body {
      font-family: 'Karla', system-ui, sans-serif;
      background: var(--surface);
      color: var(--ink);
      line-height: 1.65;
      font-size: 1.0625rem;
    }
    h1, h2, h3 { font-family: 'Fraunces', Georgia, serif; line-height: 1.15; }
    a { color: var(--accent); }
    a:focus-visible, button:focus-visible {
      outline: 3px solid var(--accent-soft); outline-offset: 2px;
    }
    .wrap { max-width: var(--max); margin: 0 auto; padding: 0 1.25rem; }

    /* Page/section headers: a short orange rule above the title, no ruled lines
       running through the text. */
    .ruled {
      position: relative;
      padding-top: 0.9rem;
    }
    .ruled::before {
      content: '';
      position: absolute; top: 0; left: 0;
      width: 2.75rem; height: 4px; border-radius: 999px;
      background: linear-gradient(90deg, var(--highlight), var(--highlight-soft));
    }
    .ruled h1, .ruled h2 { color: var(--accent-deep); }
    .eyebrow {
      font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--ink-muted);
    }
    .section-intro {
      max-width: 58ch; margin-top: 0.75rem; color: var(--ink-muted);
    }

    /* Scroll-reveal: opt-in via [data-reveal]; disabled for reduced motion. */
    @media (prefers-reduced-motion: no-preference) {
      [data-reveal] {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
      }
      [data-reveal].is-visible { opacity: 1; transform: none; }
      [data-reveal-delay="1"] { transition-delay: 0.08s; }
      [data-reveal-delay="2"] { transition-delay: 0.16s; }
      [data-reveal-delay="3"] { transition-delay: 0.24s; }
    }

    header.site {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: saturate(160%) blur(8px);
      color: var(--ink);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 1px 0 var(--shadow);
      position: sticky; top: 0; z-index: 40;
    }
    header.site .wrap {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 1.25rem;
      row-gap: 0.65rem;
      padding-top: 0.85rem;
      padding-bottom: 0.85rem;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      text-decoration: none;
      flex-shrink: 0;
    }
    .brand-text {
      display: flex;
      flex-direction: column;
      justify-content: center;
      line-height: 1.12;
      font-family: 'Fraunces', serif;
      font-weight: 700;
      color: var(--accent-deep);
    }
    .brand-line {
      font-size: 1.2rem;
      white-space: nowrap;
      letter-spacing: -0.01em;
    }
    .brand-line--sub {
      font-size: 1.08rem;
      color: var(--accent);
    }
    .logo-mark {
      display: block;
      width: 3.65rem;
      height: 3.65rem;
      flex-shrink: 0;
      background: #fff;
      border-radius: 10px;
      object-fit: contain;
      padding: 5px;
      border: 1px solid var(--border);
      box-shadow: 0 2px 10px var(--shadow);
      transition: transform 0.3s var(--ease);
    }
    .brand:hover .logo-mark { transform: rotate(-4deg) scale(1.05); }
    nav.main {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      font-size: 0.95rem;
      justify-self: start;
      min-width: 0;
    }
    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-shrink: 0;
      justify-self: end;
    }
    .header-call {
      padding: 0.55rem 1rem;
      font-size: 0.9rem;
      line-height: 1.2;
      white-space: nowrap;
    }
    .header-call-text {
      display: inline-flex;
      align-items: baseline;
      gap: 0.35rem;
    }
    .header-call-num { font-variant-numeric: tabular-nums; }
    nav.main a {
      color: var(--ink-muted); text-decoration: none;
      position: relative; padding-bottom: 2px;
    }
    nav.main a::after {
      content: ''; position: absolute; left: 0; bottom: 0;
      width: 100%; height: 2px; border-radius: 2px;
      background: var(--highlight);
      transform: scaleX(0); transform-origin: left;
      transition: transform 0.25s var(--ease);
    }
    nav.main a:hover { color: var(--accent); }
    nav.main a:hover::after, nav.main a[aria-current="page"]::after { transform: scaleX(1); }
    nav.main a[aria-current="page"] { color: var(--accent); font-weight: 600; }

    .btn {
      display: inline-block; padding: 0.7rem 1.3rem; border-radius: 8px;
      font-weight: 700; text-decoration: none; font-size: 1rem;
      transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease), background 0.2s var(--ease);
    }
    .btn-call {
      background: linear-gradient(135deg, var(--highlight), var(--highlight-deep));
      color: #fff; box-shadow: 0 3px 12px rgba(232, 130, 26, 0.3);
    }
    .btn-wa { background: transparent; color: inherit; border: 2px solid currentColor; }
    .btn-icon {
      display: inline-flex; align-items: center; gap: 0.45rem;
    }
    .btn-icon svg { flex-shrink: 0; }
    .btn-ghost {
      background: var(--surface-raised); color: var(--accent-deep);
      border: 1px solid var(--accent-soft);
    }
    .btn-ghost:hover { border-color: var(--highlight); color: var(--highlight-deep); }
    .btn:hover { transform: translateY(-2px); }
    .btn-call:hover { box-shadow: 0 6px 18px rgba(232, 130, 26, 0.38); }
    .btn:active { transform: translateY(0); }

    main section { padding: 2.75rem 0; }
    .section-muted { background: var(--surface-muted); }
    .section-raised { background: var(--surface-raised); border-block: 1px solid var(--border); }
    footer.site {
      background: var(--accent-deep); color: #dfe6f5;
      padding: 2.5rem 0; font-size: 0.95rem;
    }
    footer.site strong { color: #fff; }
    footer.site a { color: var(--highlight-soft); }
    footer.site .footer-maps { display: inline-flex; align-items: center; gap: 0.3rem; }
    .footer-layout {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 1.25rem 2rem;
      align-items: center;
    }
    .footer-brand {
      flex-shrink: 0;
      text-decoration: none;
      line-height: 0;
    }
    .footer-logo {
      display: block;
      /* Match the four-line footer block height at 0.95rem. */
      height: 5.5rem;
      width: auto;
      max-width: 5.5rem;
      object-fit: contain;
      background: #fff;
      border-radius: 10px;
      padding: 6px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.22);
      transition: transform 0.25s var(--ease);
    }
    .footer-brand:hover .footer-logo { transform: scale(1.03); }
    .footer-body p { margin: 0; line-height: 1.55; }
    .footer-body p + p { margin-top: 0.65rem; }
    @media (max-width: 640px) {
      .footer-layout { gap: 1rem 1.25rem; align-items: start; }
      .footer-logo { height: 4.5rem; max-width: 4.5rem; }
    }
    .grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
    .card {
      background: var(--surface-raised); border: 1px solid var(--border); border-radius: 12px;
      padding: 1.4rem; display: block; text-decoration: none; color: var(--ink);
      transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease), border-color 0.25s var(--ease);
    }
    .card:hover {
      border-color: var(--accent-soft);
      box-shadow: 0 10px 26px var(--shadow);
      transform: translateY(-3px);
    }
    .card h3 { color: var(--accent-deep); margin-bottom: 0.4rem; }

    /* ---- Shared layout primitives -------------------------------------
       Used instead of stacking more card grids, so pages differ in rhythm
       while still reading as one design language. */

    /* Prose column for body copy. */
    .prose { max-width: 62ch; display: grid; gap: 0.9rem; color: var(--ink-muted); }
    .prose strong { color: var(--ink); }
    .prose .lede { font-size: 1.1rem; color: var(--ink); }

    /* Soft panel with an orange edge — for a single highlighted statement. */
    .panel {
      background: var(--surface-raised);
      border: 1px solid var(--border);
      border-left: 4px solid var(--highlight);
      border-radius: 0 12px 12px 0;
      padding: 1.1rem 1.35rem;
    }
    .panel-label {
      font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--highlight-deep);
    }

    /* Numbered rows — a sequence, not a grid of boxes. */
    .steps { list-style: none; padding: 0; display: grid; gap: 0.1rem; counter-reset: step; }
    .steps li {
      counter-increment: step;
      display: grid;
      grid-template-columns: 2.25rem 1fr;
      row-gap: 0.2rem;
      padding: 0.85rem 0;
      border-top: 1px solid var(--border);
    }
    .steps li:last-child { border-bottom: 1px solid var(--border); }
    /* Number occupies the first column across both text rows. */
    .steps li::before {
      content: counter(step, decimal-leading-zero);
      grid-column: 1; grid-row: 1 / span 2;
      font-family: 'Fraunces', Georgia, serif; font-weight: 700;
      font-size: 0.95rem; color: var(--highlight);
      font-variant-numeric: tabular-nums;
      line-height: 1.6;
    }
    .steps b { grid-column: 2; color: var(--accent-deep); font-weight: 700; }
    .steps span { grid-column: 2; color: var(--ink-muted); max-width: 62ch; }

    /* Icon/text rows for short benefit lists. */
    .features { list-style: none; padding: 0; display: grid; gap: 0.85rem 2rem; }
    @media (min-width: 640px) { .features { grid-template-columns: 1fr 1fr; } }
    .features li { display: grid; grid-template-columns: auto 1fr; gap: 0.7rem; align-items: start; }
    .features .tick {
      width: 1.35rem; height: 1.35rem; border-radius: 50%; flex-shrink: 0;
      display: grid; place-items: center; margin-top: 0.15rem;
      background: var(--surface-accent); border: 1px solid var(--highlight-soft);
      color: var(--highlight-deep); font-size: 0.72rem; font-weight: 700;
    }
    .features b { display: block; color: var(--accent-deep); }
    .features span { color: var(--ink-muted); font-size: 0.95rem; }

    /* Key/value strip for contact-style details. */
    .detail-list { display: grid; gap: 0.1rem; }
    .detail-list > div {
      display: grid; gap: 0.15rem 1rem; padding: 0.8rem 0;
      border-top: 1px solid var(--border);
      grid-template-columns: 1fr;
    }
    @media (min-width: 560px) { .detail-list > div { grid-template-columns: 9rem 1fr; } }
    .detail-list > div:last-child { border-bottom: 1px solid var(--border); }
    .detail-list dt {
      font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--highlight-deep);
    }
    .detail-list dd { margin: 0; color: var(--ink); }
    dl.faq dt {
      font-weight: 700; font-family: 'Fraunces', serif; font-size: 1.1rem;
      margin-top: 1.4rem; color: var(--accent-deep);
    }
    dl.faq dd { margin: 0.4rem 0 0; }
    .contact-strip {
      background: var(--surface-raised);
      color: var(--ink);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.5rem; display: flex; flex-wrap: wrap; gap: 1rem;
      align-items: center; justify-content: space-between;
    }
    .hero {
      background: var(--surface-raised);
      border-bottom: 1px solid var(--border);
    }
    html[lang="te"] body { font-family: 'Noto Sans Telugu', 'Karla', system-ui, sans-serif; }
    html[lang="te"] h1, html[lang="te"] h2, html[lang="te"] h3, html[lang="te"] dt {
      font-family: 'Noto Sans Telugu', 'Fraunces', Georgia, serif;
    }
    .lang-toggle {
      font-family: 'Noto Sans Telugu', 'Karla', sans-serif;
      font-size: 0.9rem; font-weight: 700; text-decoration: none;
      color: var(--accent); background: var(--surface-muted);
      border: 1px solid var(--accent-soft);
      padding: 0.28rem 0.7rem; border-radius: 999px; white-space: nowrap;
      transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
    }
    .lang-toggle:hover { background: var(--surface-accent); border-color: var(--highlight); }

    /* Header: logo + two-line name stay together; nav wraps on its own row on narrow screens. */
    @media (max-width: 900px) {
      header.site .wrap {
        grid-template-columns: 1fr auto;
        grid-template-areas:
          "brand actions"
          "nav nav";
      }
      .brand { grid-area: brand; }
      .header-actions { grid-area: actions; }
      nav.main { grid-area: nav; width: 100%; }
      .brand-line { font-size: 1.05rem; }
      .brand-line--sub { font-size: 0.95rem; }
      .logo-mark { width: 3.25rem; height: 3.25rem; }
    }
    @media (max-width: 480px) {
      .header-call-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
      .header-call { padding: 0.5rem 0.75rem; font-size: 0.82rem; }
    }
  </style>
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="brand" href={homeHref}>
        <img class="logo-mark" src="/logo.png" alt="" width="58" height="58" />
        <span class="brand-text">
          <span class="brand-line">Siva Tuitions</span>
          <span class="brand-line brand-line--sub">&amp; Coachings</span>
        </span>
      </a>
      <nav class="main" aria-label={ui.navLabel}>
        {navItems.map((item) => (
          <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <div class="header-actions">
        <a class="lang-toggle" href={langHref} lang={isTe ? 'en' : 'te'} hreflang={isTe ? 'en' : 'te'}>{langLabel}</a>
        <a class="btn btn-call header-call" href={`tel:${SITE.phoneHref}`}>
          <span class="header-call-text">
            <span class="header-call-label">{ui.call}</span>
            <span class="header-call-num">{SITE.phone}</span>
          </span>
        </a>
      </div>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site">
    <div class="wrap footer-layout">
      <a class="footer-brand" href={homeHref} aria-label={SITE.name}>
        <img class="footer-logo" src="/logo.png" alt="" width="88" height="88" />
      </a>
      <div class="footer-body">
        <p><a href={SITE.mapsDirectionsUrl}>{SITE.address.street}, {SITE.address.locality}, {SITE.address.region} {SITE.address.postalCode}</a></p>
        <p>
          {ui.phoneWhatsapp}: <a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a>
          · {ui.email}: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          · <a href={SITE.mapsDirectionsUrl} class="footer-maps"><MapsIcon size={14} />{ui.maps}</a>
          · <a href={SITE.mapsUrl}>{ui.maps}</a>
        </p>
        <p>
          <a href={galleryHref}>{ui.gallery}</a>
          · <a href={socialHref}>{ui.social}</a>
          · <a href={resourcesHref}>{ui.links}</a>
          · <a href={faqHref}>{ui.faq}</a>
          · <a href="/answers/">Answers</a>
          · <a href={askHref}>{ui.ask}</a>
          · <a href={aboutHref}>{ui.about}</a>
        </p>
        <p>{ui.director}: <a href={`/director/${DIRECTOR.slug}/`}>{DIRECTOR.name}</a></p>
      </div>
    </div>
  </footer>

  <EnquiryWidget lang={locale} />

  <script>
    // Reveal-on-scroll. Elements stay visible if the observer is unavailable.
    const revealables = document.querySelectorAll('[data-reveal]');
    const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

    if (!motionOk || !('IntersectionObserver' in window)) {
      revealables.forEach((el) => el.classList.add('is-visible'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      );
      revealables.forEach((el) => io.observe(el));
    }
  </script>
</body>
</html>
