---
import { SITE, GALLERY } from '../data/site.js';
import { BRANCH_SECTION, UI } from '../data/i18n.js';
import MapsIcon from './MapsIcon.astro';

const { lang = 'en' } = Astro.props;
const copy = BRANCH_SECTION[lang];
const ui = UI[lang];
const galleryHref = lang === 'te' ? '/te/gallery/' : '/gallery/';
const featured = GALLERY[0];
const addressLine = `${SITE.address.street}, ${SITE.address.locality}, ${SITE.address.region} ${SITE.address.postalCode}`;
---
<section id="centre" class="home-branch">
  <div class="wrap branch-layout">
    <figure class="branch-photo">
      <img src={featured.src} alt={copy.featuredAlt} width="640" height="420" loading="lazy" />
    </figure>
    <div class="branch-body">
      <h2 class="branch-title">{copy.title}</h2>
      <p class="branch-lead">{copy.lead}</p>
      <dl class="branch-details">
        <div>
          <dt>{copy.addressLabel}</dt>
          <dd><a href={SITE.mapsDirectionsUrl}>{addressLine}</a></dd>
        </div>
        <div>
          <dt>{copy.hoursLabel}</dt>
          <dd>{SITE.hoursLabel}</dd>
        </div>
      </dl>
      <ul class="branch-features">
        {copy.features.map((item) => <li>{item.text}</li>)}
      </ul>
      <p class="branch-actions">
        <a class="btn btn-call" href={`tel:${SITE.phoneHref}`}>{ui.call} {SITE.phone}</a>
        <a class="btn btn-ghost btn-icon" href={SITE.mapsDirectionsUrl}>
          <MapsIcon />
          {ui.maps}
        </a>
        <a class="btn btn-ghost" href={galleryHref}>{copy.galleryLabel}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .home-branch {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .branch-layout {
    display: grid; gap: 1.75rem; align-items: start;
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) { .branch-layout { grid-template-columns: 1fr 1fr; gap: 2rem; } }

  .branch-photo {
    margin: 0; overflow: hidden; border-radius: 8px;
    border: 1px solid var(--border);
  }
  .branch-photo img {
    width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block;
  }

  .branch-title {
    font-size: 1.25rem; color: var(--accent-deep); margin-bottom: 0.5rem;
  }
  .branch-lead { color: var(--ink-muted); max-width: 42ch; line-height: 1.6; }

  .branch-details { margin-top: 1.1rem; display: grid; gap: 0.85rem; }
  .branch-details dt {
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--ink-muted);
  }
  .branch-details dd { margin: 0.15rem 0 0; color: var(--ink); line-height: 1.5; }

  .branch-features {
    list-style: disc; padding-left: 1.15rem; margin: 1rem 0 0;
    color: var(--ink-muted); font-size: 0.95rem;
    display: grid; gap: 0.35rem;
  }

  .branch-actions {
    margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: 0.6rem;
  }
</style>
