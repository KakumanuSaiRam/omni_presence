---
import { GUIDE_TOPICS, GUIDE_META, FEATURED_GUIDE_TAGS, topicById } from '../data/guides-meta.js';

const { posts } = Astro.props;

const enriched = posts.map((post) => {
  const meta = GUIDE_META[post.id] ?? { topic: 'other', tags: [] };
  const topic = topicById(meta.topic);
  return { ...post, meta, topic };
});

const sections = GUIDE_TOPICS.map((topic) => ({
  ...topic,
  posts: enriched
    .filter((p) => p.meta.topic === topic.id)
    .sort((a, b) => a.data.title.localeCompare(b.data.title)),
})).filter((s) => s.posts.length > 0);

const tagList = FEATURED_GUIDE_TAGS;
const total = enriched.length;
const defaultSection = sections[0]?.id ?? '';
---

<div class="guides-index" data-default-section={defaultSection}>
  <header class="guides-header">
    <h1>Guides</h1>
    <p class="guides-lede">{total} articles on exams, counselling and admissions.</p>
  </header>

  <div class="guides-toolbar">
    <div class="guides-toolbar-row">
      <div class="guides-search-wrap">
        <label class="guides-search-label" for="guides-search">Search</label>
        <input
          id="guides-search"
          class="guides-search"
          type="search"
          placeholder="NEET, web options…"
          autocomplete="off"
          spellcheck="false"
        />
      </div>
      <div class="guides-tags" role="group" aria-label="Filter by tag">
        <button type="button" class="guides-tag is-active" data-tag="">All</button>
        {tagList.map((tag) => (
          <button type="button" class="guides-tag" data-tag={tag.toLowerCase()}>
            {tag}
          </button>
        ))}
      </div>
    </div>
    <p class="guides-search-hint" id="guides-search-status" aria-live="polite">
      Pick a topic on the left, or search across all guides.
    </p>
  </div>

  <div class="guides-layout">
    <nav class="guides-nav" id="guides-nav" aria-label="Guide topics">
      <p class="guides-nav-label">Topics</p>
      <ul class="guides-nav-list">
        {sections.map((section, i) => (
          <li>
            <button
              type="button"
              class:list={['guides-nav-btn', { 'is-active': i === 0 }]}
              data-section={section.id}
              aria-controls={`guide-panel-${section.id}`}
            >
              <span class="guides-nav-text">{section.label}</span>
              <span class="guides-nav-count" data-section-count={section.id}>{section.posts.length}</span>
            </button>
          </li>
        ))}
      </ul>
    </nav>

    <div class="guides-main" id="guides-main">
      {sections.map((section, i) => (
        <section
          class="guides-panel"
          id={`guide-panel-${section.id}`}
          data-section={section.id}
          hidden={i !== 0}
        >
          <div class="guides-panel-head">
            <h2>{section.label}</h2>
            {section.hint && <p>{section.hint}</p>}
          </div>
          <div class="guides-list-scroll" tabindex="0" aria-label={`${section.label} guides`}>
            <ul class="guides-list">
              {section.posts.map((post) => (
                <li
                  class="guides-item"
                  data-slug={post.id}
                  data-tags={post.meta.tags.join('|').toLowerCase()}
                  data-search={`${post.data.title} ${post.data.description} ${post.meta.tags.join(' ')}`.toLowerCase()}
                >
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  <ul class="guides-item-tags" aria-label="Tags" hidden>
                    {post.meta.tags.map((tag) => (
                      <li><span class="guides-item-tag">{tag}</span></li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}

      <p class="guides-empty" id="guides-empty" hidden>No guides match. Try another keyword or tag.</p>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector('.guides-index');
  const search = document.getElementById('guides-search');
  const status = document.getElementById('guides-search-status');
  const empty = document.getElementById('guides-empty');
  const nav = document.getElementById('guides-nav');
  const navButtons = document.querySelectorAll('.guides-nav-btn');
  const tagButtons = document.querySelectorAll('.guides-tag');
  const items = document.querySelectorAll('.guides-item');
  const panels = document.querySelectorAll('.guides-panel');

  const defaultSection = root?.getAttribute('data-default-section') ?? '';
  let activeSection = defaultSection;
  let activeTag = '';
  let filtering = false;

  function isFiltering() {
    const q = (search?.value ?? '').trim();
    return q.length > 0 || activeTag.length > 0;
  }

  function setActiveSection(id) {
    activeSection = id;
    navButtons.forEach((btn) => {
      const on = btn.getAttribute('data-section') === id;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-current', on ? 'true' : 'false');
    });
    if (!filtering) {
      panels.forEach((panel) => {
        const show = panel.getAttribute('data-section') === id;
        panel.hidden = !show;
        if (show) panel.querySelector('.guides-list-scroll')?.scrollTo(0, 0);
      });
    }
  }

  function applyFilter() {
    filtering = isFiltering();
    const q = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;
    const sectionCounts = new Map();
    const sectionsWithResults = new Set();

    items.forEach((item) => {
      const haystack = item.getAttribute('data-search') ?? '';
      const tags = (item.getAttribute('data-tags') ?? '').split('|');
      const matchesQuery = !q || haystack.includes(q);
      const matchesTag = !activeTag || tags.includes(activeTag);
      const show = matchesQuery && matchesTag;
      item.hidden = !show;
      if (show) {
        visible += 1;
        const section = item.closest('.guides-panel')?.getAttribute('data-section');
        if (section) {
          sectionCounts.set(section, (sectionCounts.get(section) ?? 0) + 1);
          sectionsWithResults.add(section);
        }
      }
    });

    navButtons.forEach((btn) => {
      const id = btn.getAttribute('data-section') ?? '';
      const countEl = document.querySelector(`[data-section-count="${id}"]`);
      const count = filtering ? (sectionCounts.get(id) ?? 0) : countEl?.getAttribute('data-original-count');
      if (countEl) {
        if (!countEl.hasAttribute('data-original-count')) {
          countEl.setAttribute('data-original-count', countEl.textContent ?? '0');
        }
        countEl.textContent = String(filtering ? (sectionCounts.get(id) ?? 0) : countEl.getAttribute('data-original-count'));
      }
      if (filtering) {
        btn.classList.toggle('has-results', sectionsWithResults.has(id));
        btn.disabled = !sectionsWithResults.has(id);
      } else {
        btn.classList.remove('has-results');
        btn.disabled = false;
      }
    });

    if (filtering) {
      nav?.classList.add('is-filtering');
      panels.forEach((panel) => {
        const id = panel.getAttribute('data-section') ?? '';
        panel.hidden = !sectionsWithResults.has(id);
      });
      if (sectionsWithResults.size > 0 && !sectionsWithResults.has(activeSection)) {
        setActiveSection([...sectionsWithResults][0]);
      }
    } else {
      nav?.classList.remove('is-filtering');
      setActiveSection(activeSection || defaultSection);
    }

    if (status) {
      if (!filtering) {
        status.textContent = 'Pick a topic on the left, or search across all guides.';
      } else if (visible === 0) {
        status.textContent = 'No guides match your search.';
      } else {
        status.textContent = `${visible} guide${visible === 1 ? '' : 's'} match — showing relevant sections.`;
      }
    }
    if (empty) empty.hidden = !filtering || visible > 0;
  }

  navButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (btn.disabled) return;
      setActiveSection(btn.getAttribute('data-section') ?? '');
      if (!filtering) {
        document.getElementById(`guide-panel-${btn.getAttribute('data-section')}`)?.querySelector('.guides-list-scroll')?.scrollTo(0, 0);
      }
    });
  });

  search?.addEventListener('input', applyFilter);

  tagButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeTag = btn.getAttribute('data-tag') ?? '';
      tagButtons.forEach((b) => b.classList.toggle('is-active', b === btn));
      applyFilter();
    });
  });

  document.querySelectorAll('.guides-item-tag').forEach((tagEl) => {
    tagEl.addEventListener('click', (e) => {
      e.preventDefault();
      const tag = tagEl.textContent?.trim().toLowerCase() ?? '';
      activeTag = tag;
      tagButtons.forEach((b) => {
        b.classList.toggle('is-active', (b.getAttribute('data-tag') ?? '') === tag);
      });
      if (![...tagButtons].some((b) => b.classList.contains('is-active'))) {
        tagButtons[0]?.classList.add('is-active');
      }
      applyFilter();
    });
  });

  setActiveSection(defaultSection);
</script>

<style>
  .guides-index {
    max-width: 56rem;
  }

  .guides-header {
    margin-bottom: 1.5rem;
  }

  .guides-header h1 {
    color: var(--accent-deep);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.15;
    margin: 0 0 0.4rem;
  }

  .guides-lede {
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
  }

  .guides-toolbar {
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .guides-toolbar-row {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .guides-toolbar-row {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .guides-search-wrap {
    flex: 0 0 14rem;
    min-width: 0;
  }

  @media (max-width: 900px) {
    .guides-search-wrap {
      flex: none;
    }
  }

  .guides-search-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.35rem;
  }

  .guides-search {
    width: 100%;
    padding: 0.55rem 0.85rem;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--ink);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .guides-search:focus {
    outline: 2px solid var(--highlight-soft);
    outline-offset: 1px;
    border-color: var(--highlight-soft);
  }

  .guides-tags {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
    min-width: 0;
  }

  @media (max-width: 900px) {
    .guides-tags {
      justify-content: flex-start;
    }
  }

  .guides-tag {
    padding: 0.28rem 0.6rem;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--ink-muted);
    background: var(--surface-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
  }

  .guides-tag:hover,
  .guides-tag:focus-visible {
    border-color: var(--highlight-soft);
    color: var(--ink);
  }

  .guides-tag.is-active {
    background: var(--surface-accent);
    border-color: var(--highlight-soft);
    color: var(--highlight-deep);
    font-weight: 600;
  }

  .guides-search-hint {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  .guides-layout {
    display: grid;
    grid-template-columns: 13.5rem 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 720px) {
    .guides-layout {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .guides-nav {
    position: sticky;
    top: 5rem;
  }

  @media (max-width: 720px) {
    .guides-nav {
      position: static;
    }
  }

  .guides-nav-label {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .guides-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--surface-raised);
  }

  @media (max-width: 720px) {
    .guides-nav-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      border: none;
      background: transparent;
      overflow: visible;
    }
  }

  .guides-nav-btn {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    padding: 0.65rem 0.85rem;
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.35;
    text-align: left;
    color: var(--ink);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
  }

  @media (max-width: 720px) {
    .guides-nav-btn {
      width: auto;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.4rem 0.75rem;
      background: var(--surface-raised);
    }
  }

  .guides-nav-list li:last-child .guides-nav-btn {
    border-bottom: none;
  }

  @media (max-width: 720px) {
    .guides-nav-list li:last-child .guides-nav-btn {
      border-bottom: 1px solid var(--border);
    }
  }

  .guides-nav-btn:hover:not(:disabled),
  .guides-nav-btn:focus-visible:not(:disabled) {
    background: var(--surface-muted);
    color: var(--highlight-deep);
  }

  .guides-nav-btn.is-active {
    background: var(--surface-accent);
    color: var(--highlight-deep);
    font-weight: 600;
    box-shadow: inset 3px 0 0 var(--highlight);
  }

  @media (max-width: 720px) {
    .guides-nav-btn.is-active {
      box-shadow: none;
      border-color: var(--highlight-soft);
    }
  }

  .guides-nav-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .guides-nav-text {
    flex: 1;
  }

  .guides-nav-count {
    flex-shrink: 0;
    font-size: 0.75rem;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
    margin-top: 0.1rem;
  }

  .guides-nav-btn.is-active .guides-nav-count {
    color: var(--highlight-deep);
  }

  .guides-main {
    min-width: 0;
  }

  .guides-panel {
    scroll-margin-top: 5rem;
  }

  .guides-panel + .guides-panel:not([hidden]) {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .guides-panel-head h2 {
    font-family: 'Karla', system-ui, sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--accent-deep);
    margin: 0 0 0.3rem;
  }

  .guides-panel-head p {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  /* ~10 compact rows, then scroll */
  .guides-list-scroll {
    --guides-row: 2.85rem;
    max-height: calc(var(--guides-row) * 10);
    overflow-y: auto;
    overflow-x: hidden;
    padding-right: 0.35rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface-raised);
  }

  .guides-list-scroll:focus-visible {
    outline: 2px solid var(--highlight-soft);
    outline-offset: 1px;
  }

  .guides-list-scroll::-webkit-scrollbar {
    width: 6px;
  }

  .guides-list-scroll::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 999px;
  }

  .guides-list-scroll::-webkit-scrollbar-thumb:hover {
    background: var(--ink-muted);
  }

  .guides-list {
    list-style: none;
    margin: 0;
    padding: 0 0.85rem;
  }

  .guides-item {
    display: flex;
    align-items: center;
    min-height: var(--guides-row);
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
    box-sizing: border-box;
  }

  .guides-item:last-child {
    border-bottom: none;
  }

  .guides-item > a {
    display: block;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }

  .guides-item > a:hover,
  .guides-item > a:focus-visible {
    color: var(--highlight-deep);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .guides-item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0.2rem 0 0;
    padding: 0;
  }

  .guides-item-tag {
    font-size: 0.6875rem;
    color: var(--ink-muted);
    background: var(--surface-muted);
    padding: 0.12rem 0.45rem;
    border-radius: 4px;
    cursor: pointer;
  }

  .guides-item-tag:hover {
    color: var(--highlight-deep);
    background: var(--surface-accent);
  }

  .guides-empty {
    padding: 1.25rem;
    text-align: center;
    color: var(--ink-muted);
    background: var(--surface-muted);
    border: 1px dashed var(--border);
    border-radius: 8px;
  }
</style>
