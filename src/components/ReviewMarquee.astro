---
import { GOOGLE_LISTING, GOOGLE_REVIEWS } from '../data/reviews.js';
import { REVIEWS_SECTION } from '../data/i18n.js';

const { lang = 'en' } = Astro.props;
const copy = REVIEWS_SECTION[lang];
const track = [...GOOGLE_REVIEWS, ...GOOGLE_REVIEWS];
const countLabel = copy.countLabel.replace('{n}', GOOGLE_LISTING.reviewCount.toLocaleString('en-IN'));
---

<section id="reviews" class="review-band" aria-label={copy.title}>
  <div class="wrap review-head">
    <div class="ruled">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
    </div>
    <p class="section-intro review-lead">{copy.lead}</p>
    <p class="review-meta">
      <span class="review-score">{GOOGLE_LISTING.ratingValue}</span>
      <span class="review-stars" aria-hidden="true">★★★★★</span>
      <span>{countLabel}</span>
      <span aria-hidden="true">·</span>
      <a href={GOOGLE_LISTING.mapsUrl}>{copy.linkLabel}</a>
    </p>
  </div>

  <div class="review-viewport" data-review-marquee>
    <div class="review-track">
      {track.map((review, i) => (
        <article class="review-card" aria-hidden={i >= GOOGLE_REVIEWS.length}>
          <p class="review-topics">
            {review.topics.map((topic) => (
              <span>{copy.topics[topic]}</span>
            ))}
          </p>
          <p class="review-quote">“{review.quote}”</p>
          <footer class="review-by">
            <span class="review-author">{review.author}</span>
            <span class="review-src">{copy.source}</span>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .review-band {
    padding: 2.5rem 0 2.75rem;
    border-top: 1px solid var(--border);
    background: var(--surface);
    overflow-x: clip;
    max-width: 100%;
  }
  .review-head { margin-bottom: 1.35rem; }
  .review-head h2 {
    font-size: 1.35rem;
    margin-top: 0.15rem;
  }
  .review-lead { margin-top: 0.65rem; }
  .review-meta {
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.55rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-muted);
  }
  .review-score {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.55rem;
    color: var(--accent-deep);
    line-height: 1;
  }
  .review-stars { color: var(--highlight); letter-spacing: 0.08em; }
  .review-meta a { text-decoration: none; }
  .review-meta a:hover { text-decoration: underline; }

  .review-viewport {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    contain: layout paint;
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }
  .review-track {
    display: flex;
    gap: 1rem;
    width: max-content;
    padding: 0.35rem 1.25rem 0.6rem;
    animation: review-ltr 120s linear infinite;
    will-change: transform;
  }
  .review-viewport:hover .review-track,
  .review-viewport:focus-within .review-track {
    animation-play-state: paused;
  }

  .review-card {
    /* Percentages are circular inside a max-content track and blow the width
       up, so size against the viewport instead. */
    flex: 0 0 min(20.5rem, 78vw);
    min-height: 14.5rem;
    padding: 1.15rem 1.25rem;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-left: 3px solid var(--highlight);
    border-radius: 10px;
    box-shadow: 0 2px 10px var(--shadow);
  }

  .review-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.7rem;
  }
  .review-topics span {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-deep);
    background: var(--surface-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.18rem 0.5rem;
  }
  .review-quote {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 0.98rem;
    line-height: 1.45;
    color: var(--accent-deep);
    display: -webkit-box;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .review-by {
    margin-top: 0.85rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.82rem;
  }
  .review-author { font-weight: 700; color: var(--ink); }
  .review-src { color: var(--ink-muted); font-weight: 600; }

  @keyframes review-ltr {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .review-viewport {
      overflow-x: auto;
      mask-image: none;
      padding: 0 1.25rem;
    }
    .review-track {
      animation: none;
      padding-left: 0;
    }
    .review-card[aria-hidden='true'] { display: none; }
  }
</style>
