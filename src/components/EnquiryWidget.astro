---
import { SITE, ENQUIRY_DELIVERY } from '../data/site.js';
import { ENQUIRY_WIDGET } from '../data/i18n.js';

const { lang = 'en' } = Astro.props;
const t = ENQUIRY_WIDGET[lang] ?? ENQUIRY_WIDGET.en;
---
<button type="button" class="fab" id="enquiry-fab" aria-haspopup="dialog" aria-label={t.fabAria}>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
  </svg>
  <span>{t.fab}</span>
</button>

<dialog id="enquiry-dialog" aria-labelledby="enquiry-dialog-title">
  <form method="dialog" class="dialog-close-form">
    <button value="cancel" class="icon-close" aria-label={t.close}>&times;</button>
  </form>

  <div class="dialog-head">
    <h2 id="enquiry-dialog-title">{t.title}</h2>
    <p>{t.subtitle}</p>
  </div>

  <form id="enquiry-widget-form" novalidate>
    <div class="row">
      <label class="fld">
        <span>{t.role}</span>
        <select name="role">{t.roles.map((o) => <option>{o}</option>)}</select>
      </label>
      <label class="fld">
        <span>{t.topic} <b aria-hidden="true">*</b></span>
        <select name="topic" required>
          <option value="">—</option>
          {t.topics.map((o) => <option>{o}</option>)}
        </select>
      </label>
    </div>

    <div class="row row-3">
      <label class="fld">
        <span>{t.stage}</span>
        <select name="stage">
          <option value="">—</option>
          {t.stages.map((o) => <option>{o}</option>)}
        </select>
      </label>
      <label class="fld">
        <span>{t.stream}</span>
        <select name="stream">
          <option value="">—</option>
          {t.streams.map((o) => <option>{o}</option>)}
        </select>
      </label>
      <label class="fld">
        <span>{t.board}</span>
        <select name="board">
          <option value="">—</option>
          {t.boards.map((o) => <option>{o}</option>)}
        </select>
      </label>
    </div>

    <label class="fld">
      <span>{t.name} <b aria-hidden="true">*</b></span>
      <input type="text" name="name" required autocomplete="name" placeholder={t.namePlaceholder} />
    </label>

    <label class="fld">
      <span>{t.details} <b aria-hidden="true">*</b></span>
      <textarea name="details" rows="3" required placeholder={t.detailsPlaceholder}></textarea>
    </label>

    <div class="callback-box">
      <label class="check">
        <input type="checkbox" name="callback" id="enquiry-callback" />
        <span><strong>{t.callback}</strong><em>{t.callbackHint}</em></span>
      </label>
      <div class="callback-fields" id="enquiry-callback-fields" hidden>
        <label class="fld">
          <span>{t.phone} <b aria-hidden="true">*</b></span>
          <input type="tel" name="phone" inputmode="numeric" autocomplete="tel" placeholder={t.phonePlaceholder} maxlength="14" />
        </label>
        <label class="fld">
          <span>{t.time}</span>
          <select name="time">{t.times.map((o) => <option>{o}</option>)}</select>
        </label>
      </div>
    </div>

    <!-- Honeypot: bots fill this, humans never see it. -->
    <input type="text" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <p class="form-msg" id="enquiry-msg" hidden></p>

    <div class="dialog-actions">
      <button type="submit" class="btn-primary" id="enquiry-submit">{t.submit}</button>
      <a class="btn-ghost" id="enquiry-wa" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">{t.openWhatsapp}</a>
    </div>
  </form>

  <div class="dialog-result" id="enquiry-result" hidden>
    <div class="result-icon" id="enquiry-result-icon" aria-hidden="true">✓</div>
    <h3 id="enquiry-result-title"></h3>
    <p id="enquiry-result-body"></p>
    <div class="dialog-actions" id="enquiry-result-actions"></div>
  </div>
</dialog>

<script
  define:vars={{
    cfg: ENQUIRY_DELIVERY,
    site: { name: SITE.name, email: SITE.email, whatsapp: SITE.whatsapp },
    t,
    lang,
  }}
>
  const fab = document.getElementById('enquiry-fab');
  const dlg = document.getElementById('enquiry-dialog');
  const form = document.getElementById('enquiry-widget-form');
  const cbToggle = document.getElementById('enquiry-callback');
  const cbFields = document.getElementById('enquiry-callback-fields');
  const msg = document.getElementById('enquiry-msg');
  const submitBtn = document.getElementById('enquiry-submit');
  const waLink = document.getElementById('enquiry-wa');
  const resultBox = document.getElementById('enquiry-result');
  const resultIcon = document.getElementById('enquiry-result-icon');
  const resultTitle = document.getElementById('enquiry-result-title');
  const resultBody = document.getElementById('enquiry-result-body');
  const resultActions = document.getElementById('enquiry-result-actions');

  const digits = (v) => (v || '').replace(/\D/g, '');

  function openDialog() {
    resultBox.hidden = true;
    form.hidden = false;
    dlg.showModal();
  }

  fab.addEventListener('click', openDialog);

  // Any link pointing at #enquire opens the widget instead of jumping.
  document.querySelectorAll('a[href$="#enquire"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      openDialog();
    });
  });

  cbToggle.addEventListener('change', () => {
    cbFields.hidden = !cbToggle.checked;
    if (cbToggle.checked) cbFields.querySelector('[name="phone"]').focus();
  });

  dlg.addEventListener('click', (e) => {
    // Backdrop click closes; clicks inside the panel do not.
    if (e.target === dlg) dlg.close();
  });

  function collect() {
    const fd = new FormData(form);
    const get = (k) => (fd.get(k) || '').toString().trim();
    return {
      role: get('role'),
      topic: get('topic'),
      stage: get('stage'),
      stream: get('stream'),
      board: get('board'),
      name: get('name'),
      details: get('details'),
      callback: cbToggle.checked,
      phone: digits(get('phone')),
      time: get('time'),
      botcheck: get('botcheck'),
    };
  }

  function validate(d) {
    let bad = null;
    form.querySelectorAll('.invalid').forEach((el) => el.classList.remove('invalid'));
    const mark = (sel) => {
      const el = form.querySelector(sel);
      el.classList.add('invalid');
      bad = bad || el;
    };
    if (!d.topic) mark('[name="topic"]');
    if (!d.name) mark('[name="name"]');
    if (!d.details) mark('[name="details"]');
    if (d.callback && d.phone.length !== 10) mark('[name="phone"]');
    if (bad) {
      msg.hidden = false;
      msg.textContent = d.callback && d.phone.length !== 10 ? t.phoneError : t.required;
      bad.focus();
      return false;
    }
    msg.hidden = true;
    return true;
  }

  // Plain-text body kept in English labels so the institute always receives one
  // consistent format, whichever language the visitor used.
  function asText(d) {
    const lines = [
      `New enquiry from the website (${lang === 'te' ? 'Telugu' : 'English'})`,
      '',
      `Role: ${d.role}`,
      `Topic: ${d.topic}`,
    ];
    if (d.stage) lines.push(`Class / stage: ${d.stage}`);
    if (d.stream) lines.push(`Stream: ${d.stream}`);
    if (d.board) lines.push(`Board: ${d.board}`);
    lines.push(`Name: ${d.name}`);
    if (d.callback) {
      lines.push(`CALLBACK REQUESTED: +91 ${d.phone}`, `Best time: ${d.time}`);
    } else {
      lines.push('Callback: not requested');
    }
    lines.push('', 'Question:', d.details);
    return lines.join('\n');
  }

  function subjectFor(d) {
    const who = d.callback ? `callback +91 ${d.phone}` : 'no callback';
    return `Website enquiry — ${d.topic} — ${d.name} (${who})`;
  }

  function mailtoUrl(d) {
    return `mailto:${cfg.target}?subject=${encodeURIComponent(subjectFor(d))}&body=${encodeURIComponent(asText(d))}`;
  }

  function whatsappUrl(d) {
    return `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(asText(d))}`;
  }

  async function deliver(d) {
    const payload = {
      subject: subjectFor(d),
      from_name: d.name,
      Role: d.role,
      Topic: d.topic,
      Class_or_stage: d.stage || '—',
      Stream: d.stream || '—',
      Board: d.board || '—',
      Name: d.name,
      Callback_requested: d.callback ? 'YES' : 'No',
      Phone: d.callback ? `+91 ${d.phone}` : '—',
      Best_time: d.callback ? d.time : '—',
      Question: d.details,
      Language: lang === 'te' ? 'Telugu' : 'English',
      message: asText(d),
      botcheck: '',
    };

    if (cfg.provider === 'web3forms' && cfg.web3formsKey) {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ access_key: cfg.web3formsKey, ...payload }),
      });
      if (!res.ok) throw new Error(`web3forms ${res.status}`);
      const json = await res.json();
      if (!json.success) throw new Error(json.message || 'web3forms rejected');
      return;
    }

    if (cfg.provider === 'formsubmit') {
      const res = await fetch(`https://formsubmit.co/ajax/${encodeURIComponent(cfg.target)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ _subject: payload.subject, _template: 'table', ...payload }),
      });
      if (!res.ok) throw new Error(`formsubmit ${res.status}`);
      return;
    }

    throw new Error('no provider configured');
  }

  function showResult({ ok, d }) {
    form.hidden = true;
    resultBox.hidden = false;
    resultIcon.textContent = ok ? '✓' : '!';
    resultIcon.className = `result-icon ${ok ? 'ok' : 'warn'}`;
    resultTitle.textContent = ok ? t.successTitle : t.errorTitle;
    resultBody.textContent = ok
      ? d.callback
        ? `${t.successBody} ${t.successCallback} +91 ${d.phone}.`
        : t.successBody
      : t.errorBody;

    resultActions.replaceChildren();
    if (ok) {
      const done = document.createElement('button');
      done.type = 'button';
      done.className = 'btn-primary';
      done.textContent = t.done;
      done.addEventListener('click', () => dlg.close());
      resultActions.append(done);
    } else {
      const mail = document.createElement('a');
      mail.className = 'btn-primary';
      mail.href = mailtoUrl(d);
      mail.textContent = t.openEmail;
      const wa = document.createElement('a');
      wa.className = 'btn-ghost';
      wa.href = whatsappUrl(d);
      wa.target = '_blank';
      wa.rel = 'noopener';
      wa.textContent = t.openWhatsapp;
      resultActions.append(mail, wa);
    }
  }

  // Keep the WhatsApp escape hatch in sync with whatever is typed so far.
  form.addEventListener('input', () => {
    waLink.href = whatsappUrl(collect());
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = collect();
    if (d.botcheck) return; // honeypot tripped
    if (!validate(d)) return;

    submitBtn.disabled = true;
    submitBtn.textContent = t.sending;
    try {
      await deliver(d);
      showResult({ ok: true, d });
      form.reset();
      cbFields.hidden = true;
    } catch (err) {
      console.error('Enquiry delivery failed:', err);
      showResult({ ok: false, d });
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = t.submit;
    }
  });
</script>

<style>
  .fab {
    position: fixed; right: 1.1rem; bottom: 1.1rem; z-index: 60;
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.8rem 1.15rem; border: none; border-radius: 999px;
    background: linear-gradient(135deg, var(--highlight), var(--highlight-deep));
    color: #fff; font: inherit; font-weight: 700; font-size: 0.95rem;
    cursor: pointer; box-shadow: 0 8px 24px rgba(232, 130, 26, 0.42);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .fab:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 12px 30px rgba(232, 130, 26, 0.5); }
  .fab:active { transform: translateY(0) scale(0.99); }

  /* Attention pulse, once the page has settled. */
  @media (prefers-reduced-motion: no-preference) {
    .fab::before {
      content: ''; position: absolute; inset: 0; border-radius: inherit;
      border: 2px solid var(--highlight);
      animation: fabPulse 2.8s var(--ease) infinite;
    }
  }
  @keyframes fabPulse {
    0% { opacity: 0.7; transform: scale(1); }
    70% { opacity: 0; transform: scale(1.35); }
    100% { opacity: 0; transform: scale(1.35); }
  }
  @media (max-width: 480px) {
    .fab span { display: none; }
    .fab { padding: 0.95rem; }
  }

  dialog {
    width: min(38rem, calc(100vw - 1.5rem));
    padding: 0; border: none; border-radius: 16px;
    background: var(--surface-raised); color: var(--ink);
    box-shadow: 0 30px 70px rgba(21, 26, 77, 0.32);
    overflow: visible;
  }
  dialog::backdrop { background: rgba(21, 26, 77, 0.5); backdrop-filter: blur(3px); }
  @media (prefers-reduced-motion: no-preference) {
    dialog[open] { animation: dlgIn 0.28s var(--ease); }
    dialog[open]::backdrop { animation: fadeIn 0.28s var(--ease); }
  }
  @keyframes dlgIn {
    from { opacity: 0; transform: translateY(14px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

  .dialog-close-form { position: absolute; top: 0.5rem; right: 0.6rem; margin: 0; }
  .icon-close {
    background: transparent; border: none; font-size: 1.8rem; line-height: 1;
    color: #fff; cursor: pointer; padding: 0.15rem 0.4rem; border-radius: 6px;
  }
  .icon-close:hover { background: rgba(255, 255, 255, 0.18); }

  .dialog-head {
    background: linear-gradient(135deg, var(--accent-deep), var(--accent));
    color: #fff; padding: 1.25rem 1.5rem; border-radius: 16px 16px 0 0;
  }
  .dialog-head h2 { font-size: 1.25rem; margin: 0; }
  .dialog-head p { margin: 0.3rem 0 0; font-size: 0.92rem; opacity: 0.85; }

  #enquiry-widget-form { padding: 1.25rem 1.5rem 1.5rem; display: grid; gap: 0.85rem; }
  .row { display: grid; gap: 0.85rem; grid-template-columns: 1fr; }
  @media (min-width: 560px) {
    .row { grid-template-columns: 1fr 1fr; }
    .row-3 { grid-template-columns: repeat(3, 1fr); }
  }
  .fld { display: grid; gap: 0.3rem; }
  .fld > span { font-size: 0.85rem; font-weight: 600; color: var(--accent-deep); }
  .fld b { color: var(--highlight-deep); }
  .fld input, .fld select, .fld textarea {
    width: 100%; padding: 0.6rem 0.7rem; border-radius: 8px;
    border: 1px solid var(--border); background: var(--surface-raised);
    font: inherit; font-size: 0.95rem; color: var(--ink);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .fld input:focus, .fld select:focus, .fld textarea:focus {
    outline: none; border-color: var(--highlight);
    box-shadow: 0 0 0 3px var(--highlight-soft);
  }
  .fld .invalid, .invalid { border-color: #c0392b !important; box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.15); }

  .callback-box {
    border: 1px dashed var(--accent-soft); border-radius: 10px;
    padding: 0.85rem; background: var(--surface-muted);
  }
  .check { display: flex; gap: 0.6rem; align-items: flex-start; cursor: pointer; }
  .check input { margin-top: 0.25rem; width: 1.05rem; height: 1.05rem; accent-color: var(--highlight); }
  .check span { display: grid; }
  .check strong { font-size: 0.95rem; color: var(--accent-deep); }
  .check em { font-style: normal; font-size: 0.85rem; color: var(--ink-muted); }
  .callback-fields { display: grid; gap: 0.85rem; margin-top: 0.85rem; grid-template-columns: 1fr; }
  @media (min-width: 560px) { .callback-fields { grid-template-columns: 1fr 1fr; } }

  .hp { position: absolute; left: -9999px; opacity: 0; height: 0; width: 0; }

  .form-msg {
    margin: 0; padding: 0.6rem 0.8rem; border-radius: 8px;
    background: #fdecea; color: #a33227; font-size: 0.9rem;
    border: 1px solid rgba(192, 57, 43, 0.25);
  }

  .dialog-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: center; }
  .btn-primary {
    background: linear-gradient(135deg, var(--highlight), var(--highlight-deep));
    color: #fff; border: none; font: inherit; font-weight: 700;
    padding: 0.7rem 1.4rem; border-radius: 8px; cursor: pointer;
    text-decoration: none; display: inline-block;
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(232, 130, 26, 0.35); }
  .btn-primary:disabled { opacity: 0.6; cursor: progress; transform: none; }
  .btn-ghost {
    background: transparent; color: var(--accent); border: 2px solid var(--accent-soft);
    font: inherit; font-weight: 600; padding: 0.62rem 1.2rem; border-radius: 8px;
    cursor: pointer; text-decoration: none; display: inline-block;
    transition: border-color 0.2s var(--ease);
  }
  .btn-ghost:hover { border-color: var(--highlight); }

  .dialog-result { padding: 2rem 1.5rem; text-align: center; display: grid; gap: 0.6rem; justify-items: center; }
  .result-icon {
    width: 3rem; height: 3rem; border-radius: 50%;
    display: grid; place-items: center; font-size: 1.5rem; font-weight: 700; color: #fff;
  }
  .result-icon.ok { background: #1f7a38; }
  .result-icon.warn { background: var(--highlight-deep); }
  .dialog-result h3 { font-size: 1.15rem; color: var(--accent-deep); }
  .dialog-result p { color: var(--ink-muted); max-width: 38ch; }
  .dialog-result .dialog-actions { justify-content: center; margin-top: 0.5rem; }
</style>
