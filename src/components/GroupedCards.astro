---
import {
  COURSES,
  COUNSELLING,
  COURSE_GROUPS,
  COUNSELLING_GROUPS,
  COURSE_BADGE,
  COUNSELLING_BADGE,
} from '../data/site.js';
import {
  GROUP_LABELS,
  COURSES_TE,
  COUNSELLING_TE,
  COURSE_BADGE_TE,
  COUNSELLING_BADGE_TE,
  LISTING_TE,
} from '../data/i18n.js';

const { kind = 'courses', lang = 'en' } = Astro.props;
const isTe = lang === 'te';

const isCourses = kind === 'courses';
const items = isCourses ? COURSES : COUNSELLING;
const groups = isCourses ? COURSE_GROUPS : COUNSELLING_GROUPS;
const badges = isTe
  ? (isCourses ? COURSE_BADGE_TE : COUNSELLING_BADGE_TE)
  : (isCourses ? COURSE_BADGE : COUNSELLING_BADGE);
const teMap = isCourses ? COURSES_TE : COUNSELLING_TE;
const labels = GROUP_LABELS[lang][kind];
const basePath = isCourses ? '/courses' : '/counselling';

const bySlug = Object.fromEntries(items.map((item) => [item.slug, item]));

const sections = groups.map((group) => ({
  ...labels[group.id],
  cards: group.slugs
    .filter((slug) => bySlug[slug])
    .map((slug) => {
      const item = bySlug[slug];
      const te = isTe ? (teMap[slug] ?? {}) : {};
      return {
        slug,
        title: te.short ?? item.short,
        blurb: te.blurb ?? `${item.metaDescription.split('.')[0]}.`,
        badge: badges[slug],
        href: isTe ? (te.href ?? `${basePath}/${slug}/`) : `${basePath}/${slug}/`,
        englishOnly: isTe && !te.href,
      };
    }),
}));
---
<!-- An index of rows rather than a grid of boxes: the group label sits beside
     its entries so long lists stay scannable. -->
<div class="groups">
  {sections.map((section) => (
    <section class="group" data-reveal>
      <div class="group-head">
        <h2>{section.title}</h2>
        <p>{section.lead}</p>
      </div>
      <ul class="entries">
        {section.cards.map((card) => (
          <li>
            <a href={card.href}>
              <span class="e-main">
                <span class="e-title">{card.title}</span>
                <span class="e-badge">{card.badge}</span>
                <span class="e-blurb">{card.blurb}</span>
                {card.englishOnly && <span class="e-note">{LISTING_TE.englishPageNote}</span>}
              </span>
              <span class="e-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .groups { display: grid; gap: 2.75rem; }
  .group { display: grid; gap: 1rem; align-items: start; grid-template-columns: 1fr; }
  @media (min-width: 880px) {
    .group { grid-template-columns: 15rem 1fr; gap: 2.5rem; }
    .group-head { position: sticky; top: 5.5rem; }
  }

  .group-head h2 { font-size: 1.15rem; color: var(--accent-deep); line-height: 1.3; }
  .group-head h2::after {
    content: ''; display: block; margin-top: 0.5rem;
    width: 2rem; height: 3px; border-radius: 999px;
    background: linear-gradient(90deg, var(--highlight), var(--highlight-soft));
  }
  .group-head p { margin-top: 0.6rem; color: var(--ink-muted); font-size: 0.92rem; }

  .entries { list-style: none; padding: 0; margin: 0; display: grid; }
  .entries li { border-top: 1px solid var(--border); }
  .entries li:last-child { border-bottom: 1px solid var(--border); }

  .entries a {
    display: grid; grid-template-columns: 1fr auto; gap: 1rem;
    align-items: center; padding: 1.05rem 0.85rem;
    text-decoration: none; color: var(--ink);
    border-radius: 8px;
    transition: background 0.2s var(--ease), padding-left 0.2s var(--ease);
  }
  .entries a:hover, .entries a:focus-visible {
    background: var(--surface-raised);
    padding-left: 1.25rem;
    box-shadow: inset 3px 0 0 var(--highlight);
  }

  .e-main { display: grid; gap: 0.25rem; }
  .e-title {
    font-family: 'Fraunces', Georgia, serif; font-weight: 600;
    font-size: 1.05rem; color: var(--accent-deep);
  }
  .e-badge {
    justify-self: start;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em;
    text-transform: uppercase; color: var(--highlight-deep);
  }
  .e-blurb { color: var(--ink-muted); font-size: 0.92rem; max-width: 58ch; }
  .e-note { font-size: 0.8rem; color: var(--highlight-deep); font-weight: 600; }

  .e-arrow {
    color: var(--highlight); font-size: 1.05rem;
    transition: transform 0.2s var(--ease);
  }
  .entries a:hover .e-arrow { transform: translateX(4px); }
</style>
