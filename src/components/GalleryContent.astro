---
import { SITE, GALLERY, SOCIAL_ACTIVITIES } from '../data/site.js';
import { GALLERY_PAGE_TE } from '../data/i18n.js';

const { lang = 'en' } = Astro.props;
const isTe = lang === 'te';

const copy = isTe
  ? GALLERY_PAGE_TE
  : {
      title: 'Gallery',
      intro: 'Pattabhipuram centre',
      mapsLabel: 'view on Google Maps',
      socialTitle: SOCIAL_ACTIVITIES.title,
      socialIntro: SOCIAL_ACTIVITIES.intro,
    };
---
<section>
  <div class="wrap">
    <h1 class="page-title">{copy.title}</h1>
    <p class="section-intro">
      {copy.intro} — <a href={SITE.mapsUrl}>{copy.mapsLabel}</a>
    </p>
    <div class="gallery-grid">
      {GALLERY.map((item) => (
        <figure class="gallery-item">
          <img src={item.src} alt={item.alt} loading="lazy" width="800" height="600" />
          <figcaption>{isTe ? (item.captionTe ?? item.caption) : item.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section id="social" class="section-muted">
  <div class="wrap">
    <h2 class="section-heading">{copy.socialTitle}</h2>
    <p class="section-intro">{copy.socialIntro}</p>
    <div class="gallery-grid">
      {SOCIAL_ACTIVITIES.photos.map((item) => (
        <figure class="gallery-item">
          <img src={item.src} alt={item.alt} loading="lazy" width="800" height="600" />
          {!isTe && <figcaption>{item.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .page-title { font-size: clamp(1.8rem, 4vw, 2.4rem); color: var(--accent-deep); }
  .section-heading { font-size: 1.5rem; color: var(--accent-deep); margin-bottom: 0.5rem; }
  .gallery-grid {
    display: grid; gap: 1.25rem; margin-top: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .gallery-item {
    margin: 0; border: 1px solid var(--border); border-radius: 8px; overflow: hidden;
    background: var(--surface-raised);
  }
  .gallery-item img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; }
  .gallery-item figcaption { padding: 0.65rem 0.9rem; font-size: 0.9rem; color: var(--ink-muted); }
</style>
