---
import { SITE, GALLERY, SOCIAL_ACTIVITIES } from '../data/site.js';
import { GALLERY_PAGE_TE } from '../data/i18n.js';

const { lang = 'en' } = Astro.props;
const isTe = lang === 'te';

const copy = isTe
  ? GALLERY_PAGE_TE
  : {
      title: 'Gallery',
      intro: 'Photos from our Pattabhipuram centre — classrooms, counselling desk, and community events.',
      mapsLabel: 'view on Google Maps',
      socialTitle: SOCIAL_ACTIVITIES.title,
      socialIntro: SOCIAL_ACTIVITIES.intro,
    };

const heroPhoto = GALLERY[0];
---
<section class="gallery-hero">
  <div class="wrap hero-split">
    <div data-reveal>
      <p class="eyebrow">Pattabhipuram · Guntur</p>
      <h1 class="page-title">{copy.title}</h1>
      <p class="section-intro">{copy.intro}</p>
      <p class="hero-links">
        <a class="btn btn-call" href={`tel:${SITE.phoneHref}`}>Call {SITE.phone}</a>
        <a class="btn btn-ghost" href={SITE.mapsDirectionsUrl}>{copy.mapsLabel} →</a>
      </p>
    </div>
    <figure class="hero-photo" data-reveal data-reveal-delay="1">
      <img src={heroPhoto.src} alt={heroPhoto.alt} width="560" height="380" loading="eager" />
    </figure>
  </div>
</section>

<section>
  <div class="wrap">
    <h2 class="strip-label" data-reveal>At the centre</h2>
    <div class="gallery-grid">
      {GALLERY.map((item, i) => (
        <figure class="gallery-item" data-reveal data-reveal-delay={String(Math.min((i % 3) + 1, 3))}>
          <img src={item.src} alt={item.alt} loading="lazy" width="800" height="600" />
          <figcaption>{isTe ? (item.captionTe ?? item.caption) : item.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section id="social" class="section-muted">
  <div class="wrap">
    <h2 class="section-heading" data-reveal>{copy.socialTitle}</h2>
    <p class="section-intro" data-reveal>{copy.socialIntro}</p>
    <div class="gallery-grid">
      {SOCIAL_ACTIVITIES.photos.map((item, i) => (
        <figure class="gallery-item" data-reveal data-reveal-delay={String(Math.min((i % 3) + 1, 3))}>
          <img src={item.src} alt={item.alt} loading="lazy" width="800" height="600" />
          {!isTe && <figcaption>{item.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-hero {
    background: linear-gradient(180deg, var(--surface-muted), var(--surface));
    border-bottom: 1px solid var(--border);
    padding: 2.5rem 0 2rem;
  }
  .hero-split {
    display: grid; gap: 1.5rem; align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) { .hero-split { grid-template-columns: 1fr 1fr; } }
  .page-title { font-size: clamp(1.8rem, 4vw, 2.4rem); color: var(--accent-deep); margin-top: 0.3rem; }
  .section-intro { max-width: 52ch; margin-top: 0.65rem; color: var(--ink-muted); }
  .hero-links { margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .hero-photo {
    margin: 0; overflow: hidden; border-radius: 14px;
    border: 1px solid var(--border); box-shadow: 0 14px 32px var(--shadow);
  }
  .hero-photo img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; }

  .strip-label {
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--highlight-deep);
    margin-bottom: 0.9rem;
  }
  .section-heading { font-size: 1.5rem; color: var(--accent-deep); margin-bottom: 0.5rem; }
  .gallery-grid {
    display: grid; gap: 1.25rem; margin-top: 0.5rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .gallery-item {
    margin: 0; border: 1px solid var(--border); border-radius: 12px; overflow: hidden;
    background: var(--surface-raised);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .gallery-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px var(--shadow);
  }
  .gallery-item img {
    width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block;
    transition: transform 0.4s var(--ease);
  }
  .gallery-item:hover img { transform: scale(1.04); }
  .gallery-item figcaption { padding: 0.75rem 1rem; font-size: 0.9rem; color: var(--ink-muted); }
</style>
