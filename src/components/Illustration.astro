---
const {
  src,
  alt,
  class: className = '',
  width = 900,
  height = 600,
  eager = false,
} = Astro.props;
---
<img
  src={src}
  alt={alt}
  class={`illus ${className}`}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>

<style>
  .illus {
    width: 100%; height: auto; display: block;
    border-radius: 10px; border: 1px solid var(--border);
    background: var(--surface-muted);
  }
</style>
