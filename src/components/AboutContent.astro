---
import Illustration from './Illustration.astro';
import { SITE, DIRECTOR, BRAND, GALLERY } from '../data/site.js';
import { ABOUT_SECTION, WHY_SECTION, ABOUT_PAGE, HERO, TRUST, UI } from '../data/i18n.js';

const { lang = 'en' } = Astro.props;
const about = ABOUT_SECTION[lang];
const why = WHY_SECTION[lang];
const page = ABOUT_PAGE[lang];
const ui = UI[lang];
const trust = TRUST[lang];
const galleryHref = lang === 'te' ? '/te/gallery/' : '/gallery/';
const contactHref = lang === 'te' ? '/te/contact/' : '/contact/';
const galleryPhotos = GALLERY.slice(0, 3);
---

<!-- Hero -->
<section class="hero-band">
  <div class="wrap hero-split">
    <div class="hero-copy">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{about.title}</h1>
      <p class="hero-sub">{HERO[lang].subline}</p>
    </div>
    <div class="hero-media">
      <Illustration src="/illustrations/graduation-joy.svg" alt={page.heroImageAlt} class="hero-art" />
    </div>
  </div>
</section>

<!-- Credibility strip -->
<section class="trust-band section-raised">
  <div class="wrap">
    <ul class="trust-list">
      {trust.map((item, i) => (
        <li data-reveal data-reveal-delay={String(Math.min(i + 1, 3))}>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Story + pillars -->
<section>
  <div class="wrap">
    <div class="split-section">
      <div data-reveal>
        <h2 class="lbl">{page.storyLabel}</h2>
        <p class="story-lead">{page.storyLead}</p>
        <div class="panel aim">
          <p class="panel-label">{about.aimLabel}</p>
          <p>{about.aim}</p>
        </div>
      </div>
      <div data-reveal data-reveal-delay="1">
        <Illustration src="/illustrations/students-classroom.svg" alt={page.storyImageAlt} class="section-art" />
      </div>
    </div>

    <div class="pillar-block" data-reveal>
      <p class="lbl">{page.pillarsLabel}</p>
      <div class="pillar-grid">
        {page.pillars.map((pillar, i) => (
          <a class="pillar-card" href={pillar.href} data-reveal data-reveal-delay={String(Math.min(i + 1, 3))}>
            <span class="pillar-icon" aria-hidden="true">{pillar.icon}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.body}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Director -->
<section class="section-muted" data-reveal>
  <div class="wrap">
    <h2 class="lbl">{page.directorLabel}</h2>
    <div class="director">
      <img
        src={BRAND.directorImage}
        alt={`${DIRECTOR.name}, ${page.directorRole}`}
        width="320"
        height="400"
        loading="lazy"
      />
      <div class="director-body">
        <p class="d-role">{page.directorRole}</p>
        <h3 class="d-name">{DIRECTOR.honorific} {DIRECTOR.name}</h3>
        <p class="d-creds-label">{page.credentialsLabel}</p>
        <ul class="d-creds">
          {DIRECTOR.credentials.map((c) => <li>{c}</li>)}
        </ul>
        <p class="d-bio">{about.directorIntro}</p>
        <p class="d-link"><a href={`/director/${DIRECTOR.slug}/`}>{page.profileLink} &rarr;</a></p>
      </div>
    </div>
  </div>
</section>

<!-- Why choose -->
<section data-reveal>
  <div class="wrap">
    <h2 class="lbl">{page.whyLabel}</h2>
    <h3 class="h-sub">{why.title}</h3>
    <ul class="why-grid">
      {why.points.map((point, i) => (
        <li data-reveal data-reveal-delay={String(Math.min((i % 3) + 1, 3))}>
          <span class="why-icon" aria-hidden="true">{point.icon}</span>
          <span>{point.text}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Values -->
<section class="section-muted" data-reveal>
  <div class="wrap">
    <h2 class="lbl">{page.valuesLabel}</h2>
    <ol class="steps">
      {page.values.map((value) => (
        <li><b>{value.title}</b><span>{value.body}</span></li>
      ))}
    </ol>
  </div>
</section>

<!-- Centre photos -->
<section data-reveal>
  <div class="wrap">
    <h2 class="lbl">{page.galleryLabel}</h2>
    <div class="photo-strip">
      {galleryPhotos.map((photo, i) => (
        <figure class="photo-thumb" data-reveal data-reveal-delay={String(Math.min(i + 1, 3))}>
          <img src={photo.src} alt={photo.alt} width="280" height="180" loading="lazy" />
        </figure>
      ))}
    </div>
    <p class="gallery-link"><a href={galleryHref}>{page.galleryLink} &rarr;</a></p>
  </div>
</section>

<!-- CTA -->
<section data-reveal>
  <div class="wrap cta">
    <div>
      <h2 class="h-sub" style="margin:0">{page.ctaTitle}</h2>
      <p style="color:var(--ink-muted);margin-top:0.35rem">{page.ctaBody}</p>
    </div>
    <div class="cta-actions">
      <a class="btn" href={`tel:${SITE.phoneHref}`}>{ui.call} {SITE.phone}</a>
      <a class="btn btn-ghost" href={galleryHref}>{ui.gallery}</a>
      <a class="btn btn-ghost" href={contactHref}>{ui.ask}</a>
    </div>
  </div>
</section>

<style>
  .hero-band {
    background: linear-gradient(180deg, var(--surface-muted), var(--surface));
    border-bottom: 1px solid var(--border);
    padding: 2.5rem 0 2rem;
  }
  .hero-split {
    display: grid; gap: 1.5rem; align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .hero-split { grid-template-columns: 1.05fr 0.85fr; } }
  .hero-band h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    color: var(--accent-deep);
    max-width: 30ch;
    margin-top: 0.3rem;
  }
  .hero-sub { margin-top: 0.7rem; color: var(--highlight-deep); font-weight: 600; }
  .hero-art { max-width: 18rem; margin: 0 auto; }

  /* Trust strip */
  .trust-band { padding: 1.25rem 0; }
  .trust-list {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
  }
  .trust-list li {
    display: grid; gap: 0.1rem;
    padding-left: 0.85rem; border-left: 3px solid var(--highlight-soft);
  }
  .trust-list strong { color: var(--accent-deep); font-size: 1.02rem; line-height: 1.3; }
  .trust-list span { color: var(--ink-muted); font-size: 0.85rem; }

  /* Section labels */
  .lbl {
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--highlight-deep);
    margin-bottom: 0.9rem;
  }
  .h-sub { font-size: 1.3rem; color: var(--accent-deep); margin-bottom: 0.9rem; }

  /* Story */
  .split-section {
    display: grid; gap: 1.75rem; align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .split-section { grid-template-columns: 1fr 1fr; } }
  .section-art { max-width: 20rem; margin: 0 auto; }
  .story-lead { color: var(--ink); font-size: 1.08rem; max-width: 52ch; line-height: 1.55; }
  .aim { margin-top: 1.25rem; max-width: 52ch; }
  .aim p:last-child { margin-top: 0.3rem; color: var(--ink); }

  /* Service pillars */
  .pillar-block { margin-top: 2.5rem; }
  .pillar-grid {
    display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .pillar-card {
    display: block; text-decoration: none; color: var(--ink);
    background: var(--surface-raised); border: 1px solid var(--border);
    border-radius: 12px; padding: 1.25rem;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .pillar-card:hover {
    border-color: var(--accent-soft);
    box-shadow: 0 10px 24px var(--shadow);
    transform: translateY(-3px);
  }
  .pillar-icon { font-size: 1.4rem; display: block; margin-bottom: 0.35rem; }
  .pillar-card h3 { color: var(--accent-deep); font-size: 1.02rem; margin-bottom: 0.35rem; }
  .pillar-card p { color: var(--ink-muted); font-size: 0.92rem; margin: 0; }

  /* Director */
  .director {
    display: grid; gap: 1.5rem; align-items: start;
    grid-template-columns: 1fr;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.4rem;
    box-shadow: 0 12px 30px var(--shadow);
  }
  @media (min-width: 680px) {
    .director { grid-template-columns: minmax(10rem, 13rem) 1fr; gap: 2rem; padding: 1.75rem; }
  }
  .director img {
    width: 100%; height: auto; border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface-muted);
    object-fit: cover;
  }
  .director-body { display: grid; gap: 0.15rem; }
  .d-role {
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--highlight-deep);
  }
  .d-name {
    font-size: clamp(1.25rem, 2.6vw, 1.6rem);
    color: var(--accent-deep);
    line-height: 1.25;
  }
  .d-creds-label {
    margin-top: 0.9rem; font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted);
  }
  .d-creds {
    list-style: none; padding: 0; margin: 0.4rem 0 0;
    display: flex; flex-wrap: wrap; gap: 0.4rem;
  }
  .d-creds li {
    font-size: 0.85rem; font-weight: 600;
    padding: 0.25rem 0.65rem; border-radius: 999px;
    background: var(--surface-accent);
    border: 1px solid var(--highlight-soft);
    color: var(--highlight-deep);
  }
  .d-bio { margin-top: 1rem; color: var(--ink-muted); max-width: 58ch; }
  .d-link { margin-top: 0.75rem; font-weight: 600; }

  /* Why grid */
  .why-grid {
    list-style: none; padding: 0; margin-top: 0.5rem;
    display: grid; gap: 0.85rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .why-grid li {
    display: grid; grid-template-columns: auto 1fr; gap: 0.65rem;
    align-items: start; font-weight: 600;
    background: var(--surface-raised); border: 1px solid var(--border);
    border-radius: 10px; padding: 0.85rem 1rem;
  }
  .why-icon { font-size: 1.15rem; line-height: 1.3; }

  /* Photo strip */
  .photo-strip {
    display: grid; gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  }
  .photo-thumb {
    margin: 0; overflow: hidden; border-radius: 10px;
    border: 1px solid var(--border);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .photo-thumb:hover { transform: translateY(-3px); box-shadow: 0 10px 24px var(--shadow); }
  .photo-thumb img {
    width: 100%; height: 9rem; object-fit: cover; display: block;
    transition: transform 0.4s var(--ease);
  }
  .photo-thumb:hover img { transform: scale(1.05); }
  .gallery-link { margin-top: 1rem; font-weight: 600; }

  /* CTA */
  .cta {
    display: grid; gap: 1.1rem; align-items: center;
    grid-template-columns: 1fr;
    background: var(--surface-accent);
    border: 1px solid var(--highlight-soft);
    border-radius: 14px;
    padding: 1.5rem;
  }
  @media (min-width: 760px) { .cta { grid-template-columns: 1fr auto; } }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
