---
import { SITE } from '../data/site.js';
import { ENQUIRY_FORM } from '../data/i18n.js';

const { compact = false, id = 'enquiry-form', lang = 'en' } = Astro.props;
const t = ENQUIRY_FORM[lang] ?? ENQUIRY_FORM.en;
---
<form class:list={['enquiry-form', { compact }]} id={id} novalidate>
  <div class="field-row">
    <label class="field">
      <span>{t.category}</span>
      <select name="category" required>
        <option value="">{t.categoryPlaceholder}</option>
        {t.categories.map((cat) => (
          <option value={cat}>{cat}</option>
        ))}
      </select>
    </label>
    <label class="field">
      <span>{t.name}</span>
      <input type="text" name="name" required autocomplete="name" placeholder={t.namePlaceholder} />
    </label>
  </div>

  <div class="field-row">
    <label class="field field-phone">
      <span>{t.phone} <em class="hint">{t.phoneRecommended}</em></span>
      <input type="tel" name="phone" inputmode="tel" autocomplete="tel" placeholder={t.phonePlaceholder} maxlength="14" />
      <small class="phone-nudge">{t.phoneNudge}</small>
    </label>
    <label class="field">
      <span>{t.email} <em class="hint optional">{t.optional}</em></span>
      <input type="email" name="email" autocomplete="email" placeholder="you@example.com" />
    </label>
  </div>

  <label class="field">
    <span>{t.question}</span>
    <textarea name="question" rows={compact ? 3 : 4} required placeholder={t.questionPlaceholder}></textarea>
  </label>

  <p class="email-note" id={`${id}-email-note`} hidden>{t.emailNote}</p>

  <div class="actions">
    <button type="button" class="btn-submit-wa" id={`${id}-wa`}>{t.sendWhatsapp}</button>
    <button type="button" class="btn-email" id={`${id}-email`}>{t.sendEmail}</button>
  </div>
</form>

<script define:vars={{ formId: id, whatsapp: SITE.whatsapp, email: SITE.email, institute: SITE.name }}>
  const form = document.getElementById(formId);
  const waBtn = document.getElementById(`${formId}-wa`);
  const emailBtn = document.getElementById(`${formId}-email`);
  const emailNote = document.getElementById(`${formId}-email-note`);
  const phoneInput = form.querySelector('[name="phone"]');

  function digits(value) {
    return (value || '').replace(/\D/g, '');
  }

  function hasPhone() {
    return digits(phoneInput.value).length >= 10;
  }

  // Field labels stay in English so the institute receives one consistent format
  // regardless of which language the visitor used.
  function buildMessage(data) {
    const phone = digits(data.phone);
    const lines = [`Hello ${institute},`, '', 'I have a question:', '', `Category: ${data.category}`, `Name: ${data.name}`];
    if (phone.length >= 10) lines.push(`Mobile: +91 ${phone.slice(-10)}`);
    if (data.email) lines.push(`Email: ${data.email}`);
    lines.push('', 'Question:', data.question);
    return lines.join('\n');
  }

  function getData() {
    const fd = new FormData(form);
    return {
      category: (fd.get('category') || '').toString().trim(),
      name: (fd.get('name') || '').toString().trim(),
      phone: (fd.get('phone') || '').toString().trim(),
      email: (fd.get('email') || '').toString().trim(),
      question: (fd.get('question') || '').toString().trim(),
    };
  }

  function validate(data) {
    if (!data.category || !data.name || !data.question) {
      form.reportValidity();
      return false;
    }
    return true;
  }

  function updateUi() {
    emailNote.hidden = hasPhone();
  }

  phoneInput.addEventListener('input', updateUi);
  updateUi();

  waBtn.addEventListener('click', () => {
    const data = getData();
    if (!validate(data)) return;
    if (!hasPhone()) {
      phoneInput.focus();
      emailNote.hidden = false;
      return;
    }
    window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(buildMessage(data))}`, '_blank', 'noopener');
  });

  emailBtn.addEventListener('click', () => {
    const data = getData();
    if (!validate(data)) return;
    const subject = encodeURIComponent(`Parent enquiry — ${data.category}`);
    window.location.href = `mailto:${email}?subject=${subject}&body=${encodeURIComponent(buildMessage(data))}`;
  });
</script>

<style>
  .enquiry-form { display: grid; gap: 1rem; max-width: 40rem; }
  .field-row { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 600px) {
    .field-row { grid-template-columns: 1fr 1fr; }
    .compact .field-row { grid-template-columns: 1fr; }
  }
  .field { display: grid; gap: 0.35rem; }
  .field > span { font-weight: 600; font-size: 0.92rem; color: var(--accent-deep); }
  .hint { font-weight: 500; font-style: normal; color: var(--highlight); font-size: 0.85rem; }
  .hint.optional { color: var(--ink-muted); }
  .field input, .field select, .field textarea {
    width: 100%; padding: 0.65rem 0.75rem; border-radius: 6px;
    border: 1px solid var(--border); background: var(--surface-raised);
    font: inherit; color: var(--ink);
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: 2px solid var(--accent-soft); border-color: var(--accent);
  }
  .phone-nudge { color: var(--ink-muted); font-size: 0.85rem; line-height: 1.4; }
  .email-note {
    margin: 0; padding: 0.65rem 0.85rem; border-radius: 6px;
    background: var(--surface-accent); border: 1px solid var(--border);
    font-size: 0.9rem; color: var(--ink-muted);
  }
  .actions { display: flex; flex-wrap: wrap; gap: 0.65rem; }
  .btn-submit-wa {
    background: #1f7a38; color: #fff; border: 2px solid #1f7a38;
    font: inherit; font-weight: 700; padding: 0.7rem 1.3rem;
    border-radius: 6px; cursor: pointer;
  }
  .btn-email {
    background: transparent; color: var(--accent-deep);
    border: 2px solid var(--accent-soft); font: inherit; font-weight: 600;
    padding: 0.7rem 1.3rem; border-radius: 6px; cursor: pointer;
  }
  .btn-submit-wa:hover { filter: brightness(1.08); }
  .btn-email:hover { border-color: var(--accent); }
</style>
