---
import EnquiryForm from './EnquiryForm.astro';
import BranchShowcase from './BranchShowcase.astro';
import MapsIcon from './MapsIcon.astro';
import { SITE, DIRECTOR, BRAND, GLOBAL_FAQS } from '../data/site.js';
import {
  UI,
  HERO,
  TRUST,
  SERVICES_OVERVIEW,
  TUITIONS_SECTION,
  COACHING_SECTION,
  COUNSELLING_SECTION,
  WHY_SECTION,
  ENQUIRE_SECTION,
  ABOUT_SECTION,
  FAQ_SECTION,
  CONTACT_SECTION,
  FAQS_TE,
} from '../data/i18n.js';

const { lang = 'en' } = Astro.props;

const ui = UI[lang];
const hero = HERO[lang];
const trust = TRUST[lang];
const services = SERVICES_OVERVIEW[lang];
const tuitions = TUITIONS_SECTION[lang];
const coaching = COACHING_SECTION[lang];
const counselling = COUNSELLING_SECTION[lang];
const why = WHY_SECTION[lang];
const enquire = ENQUIRE_SECTION[lang];
const about = ABOUT_SECTION[lang];
const faqBlock = FAQ_SECTION[lang];
const contact = CONTACT_SECTION[lang];

const homeFaqs = (lang === 'te' ? FAQS_TE : GLOBAL_FAQS).slice(0, 3);
const addressLine = `${SITE.address.street}, ${SITE.address.locality}, ${SITE.address.region} ${SITE.address.postalCode}`;
const waHref = `https://wa.me/${SITE.whatsapp}`;
const telHref = `tel:${SITE.phoneHref}`;
const galleryHref = lang === 'te' ? '/te/gallery/' : '/gallery/';
---

<!-- Hero -->
<section class="home-hero">
  <div class="wrap home-hero-inner">
    <p class="home-eyebrow">{hero.eyebrow}</p>
    <h1 class="home-title">{hero.title}</h1>
    <p class="home-lead">{hero.lead}</p>
    <div class="home-actions">
      <a class="btn btn-call" href={telHref}>{ui.call} {SITE.phone}</a>
      <span class="home-action-links">
        <a href={waHref}>{ui.whatsapp}</a>
        <span aria-hidden="true">·</span>
        <a href={SITE.mapsDirectionsUrl} class="home-maps-link"><MapsIcon size={16} />{ui.maps}</a>
      </span>
    </div>
    <ul class="home-meta">
      {trust.map((item) => (
        <li><strong>{item.value}</strong> {item.label}</li>
      ))}
    </ul>
  </div>
</section>

<BranchShowcase lang={lang} />

<!-- What we do -->
<section id="services" class="home-section">
  <div class="wrap">
    <h2 class="home-h2">{services.title}</h2>
    <p class="home-text">{services.lead}</p>
    <ul class="home-service-list">
      {services.items.map((item) => (
        <li>
          <a href={item.href}>
            <span class="home-service-name">{item.title}</span>
            <span class="home-service-desc">{item.body}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Tuitions, coaching, counselling — one calm block -->
<section class="home-section home-section--line">
  <div class="wrap home-offerings">
    <article id="tuitions" class="home-offer">
      <h3 class="home-h3">{tuitions.title}</h3>
      <p class="home-text">{tuitions.lead}</p>
      {tuitions.groups.map((group) => (
        <p class="home-detail"><strong>{group.label}:</strong> {group.items.join(', ')}</p>
      ))}
      <p class="home-links">
        {tuitions.links.map((link, i) => (
          <>
            {i > 0 && ' · '}
            <a href={link.href}>{link.label}</a>
          </>
        ))}
      </p>
    </article>

    <article id="coaching" class="home-offer">
      <h3 class="home-h3">{coaching.title}</h3>
      <p class="home-text">{coaching.lead}</p>
      <p class="home-detail"><strong>{coaching.programs.join(' · ')}</strong></p>
      <p class="home-detail">{coaching.focusLabel}: {coaching.focus.join(', ')}</p>
      <p class="home-links">
        {coaching.links.map((link, i) => (
          <>
            {i > 0 && ' · '}
            <a href={link.href}>{link.label}</a>
          </>
        ))}
      </p>
    </article>

    <article id="counselling" class="home-offer">
      <h3 class="home-h3">{counselling.title}</h3>
      <p class="home-text">{counselling.lead}</p>
      <p class="home-text home-note">{counselling.objective}</p>
      {counselling.columns.map((column) => (
        <div class="home-subblock">
          <h4 class="home-h4">{column.title}</h4>
          <p class="home-detail">{column.items.join(' · ')}</p>
        </div>
      ))}
      <p class="home-links"><a href={counselling.linkHref}>{counselling.linkLabel}</a></p>
    </article>
  </div>
</section>

<!-- Why choose -->
<section class="home-section">
  <div class="wrap">
    <h2 class="home-h2">{why.title}</h2>
    <ul class="home-checklist">
      {why.points.map((point) => <li>{point.text}</li>)}
    </ul>
  </div>
</section>

<!-- Enquiry -->
<section id="enquire" class="home-section home-section--line">
  <div class="wrap home-enquire">
    <div class="home-enquire-copy">
      <h2 class="home-h2">{enquire.title}</h2>
      <p class="home-text">{enquire.lead}</p>
      <p class="home-links"><a href={enquire.linkHref}>{enquire.linkLabel}</a></p>
    </div>
    <EnquiryForm compact id="home-enquiry" lang={lang} />
  </div>
</section>

<!-- About & director -->
<section id="about" class="home-section">
  <div class="wrap home-about">
    <div>
      <h2 class="home-h2">{about.title}</h2>
      <p class="home-text">{about.paragraphs[0]}</p>
      <p class="home-links"><a href={about.linkHref}>{about.linkLabel}</a></p>
    </div>
    <figure class="home-director">
      <img src={BRAND.directorImage} alt={`${DIRECTOR.name}, ${DIRECTOR.role}`} width="120" height="150" loading="lazy" />
      <figcaption>
        <p class="home-director-name">{DIRECTOR.name}</p>
        <p class="home-director-creds">{DIRECTOR.credentials.join(' · ')}</p>
        <p class="home-text">{about.directorIntro}</p>
        <p class="home-links"><a href={`/director/${DIRECTOR.slug}/`}>{ui.fullProfile}</a></p>
      </figcaption>
    </figure>
  </div>
</section>

<!-- FAQ -->
<section class="home-section home-section--line">
  <div class="wrap home-faq">
    <h2 class="home-h2">{faqBlock.title}</h2>
    <dl class="home-faq-list">
      {homeFaqs.map(({ q, a }) => (
        <>
          <dt>{q}</dt>
          <dd>{a}</dd>
        </>
      ))}
    </dl>
    <p class="home-links"><a href={faqBlock.linkHref}>{faqBlock.linkLabel}</a></p>
  </div>
</section>

<!-- Contact -->
<section class="home-section">
  <div class="wrap">
    <div class="home-contact">
      <div>
        <h2 class="home-h2">{contact.title}</h2>
        <p class="home-text"><a href={SITE.mapsDirectionsUrl}>{addressLine}</a></p>
        <p class="home-text">
          <a href={telHref}>{SITE.phone}</a>
          · <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          · <a href={galleryHref}>{ui.gallery}</a>
        </p>
      </div>
      <div class="home-contact-actions">
        <a class="btn btn-call" href={telHref}>{ui.callNow}</a>
        <a class="btn btn-ghost" href={contact.askHref}>{contact.askLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    padding: 2.75rem 0 2rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-raised);
  }
  .home-hero-inner { max-width: 40rem; }
  .home-eyebrow {
    font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--ink-muted);
  }
  .home-title {
    font-size: clamp(1.65rem, 4vw, 2.25rem);
    color: var(--accent-deep); margin: 0.5rem 0 0.75rem; line-height: 1.2;
  }
  .home-lead {
    color: var(--ink-muted); font-size: 1.05rem; line-height: 1.65; max-width: 42ch;
  }
  .home-actions {
    margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 1rem 1.25rem;
    align-items: center;
  }
  .home-action-links {
    display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.45rem;
    font-size: 0.95rem; font-weight: 600;
  }
  .home-action-links a { text-decoration: none; color: var(--accent); }
  .home-action-links a:hover { text-decoration: underline; }
  .home-maps-link { display: inline-flex; align-items: center; gap: 0.3rem; }
  .home-meta {
    list-style: none; padding: 0; margin: 1.75rem 0 0;
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem;
    font-size: 0.88rem; color: var(--ink-muted);
    border-top: 1px solid var(--border); padding-top: 1.25rem;
  }
  .home-meta strong { color: var(--ink); font-weight: 600; }

  .home-section { padding: 2.5rem 0; }
  .home-section--line { border-top: 1px solid var(--border); }

  .home-h2 {
    font-size: 1.35rem; color: var(--accent-deep); margin-bottom: 0.65rem;
  }
  .home-h3 { font-size: 1.12rem; color: var(--accent-deep); margin-bottom: 0.4rem; }
  .home-h4 {
    font-size: 0.88rem; font-weight: 700; color: var(--ink);
    margin: 0.85rem 0 0.25rem; font-family: 'Karla', system-ui, sans-serif;
  }
  .home-text {
    color: var(--ink-muted); max-width: 58ch; line-height: 1.65;
  }
  .home-note { margin-top: 0.5rem; font-style: italic; }
  .home-links { margin-top: 0.85rem; font-weight: 600; font-size: 0.95rem; }
  .home-detail {
    margin-top: 0.5rem; font-size: 0.95rem; color: var(--ink-muted); max-width: 58ch;
  }
  .home-detail strong { color: var(--ink); font-weight: 600; }

  .home-service-list {
    list-style: none; padding: 0; margin: 1.25rem 0 0;
    border: 1px solid var(--border); border-radius: 10px; overflow: hidden;
  }
  .home-service-list li + li { border-top: 1px solid var(--border); }
  .home-service-list a {
    display: block; padding: 1rem 1.1rem; text-decoration: none; color: inherit;
    transition: background 0.15s ease;
  }
  .home-service-list a:hover { background: var(--surface-muted); }
  .home-service-name {
    display: block; font-weight: 700; color: var(--accent-deep); margin-bottom: 0.15rem;
  }
  .home-service-desc { display: block; font-size: 0.92rem; color: var(--ink-muted); }

  .home-offerings { display: grid; gap: 2.25rem; }
  @media (min-width: 720px) {
    .home-offerings { grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }
  }
  .home-offer + .home-offer {
    padding-top: 2rem; border-top: 1px solid var(--border);
  }
  @media (min-width: 720px) {
    .home-offer + .home-offer { padding-top: 0; border-top: none; }
  }
  .home-subblock + .home-subblock { margin-top: 0.5rem; }

  .home-checklist {
    margin: 0.75rem 0 0; padding-left: 1.2rem; max-width: 42rem;
    color: var(--ink-muted); display: grid; gap: 0.45rem;
  }
  .home-checklist li { line-height: 1.5; }

  .home-enquire {
    display: grid; gap: 1.75rem; align-items: start;
  }
  @media (min-width: 720px) {
    .home-enquire { grid-template-columns: 0.85fr 1.15fr; gap: 2.5rem; }
  }

  .home-about {
    display: grid; gap: 2rem; align-items: start;
  }
  @media (min-width: 720px) {
    .home-about { grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  }
  .home-director {
    margin: 0; display: grid; gap: 1rem;
    grid-template-columns: 7rem 1fr; align-items: start;
  }
  .home-director img {
    width: 100%; border-radius: 8px; border: 1px solid var(--border); object-fit: cover;
  }
  .home-director-name {
    font-family: 'Fraunces', Georgia, serif; font-weight: 600;
    color: var(--accent-deep); font-size: 1.05rem;
  }
  .home-director-creds {
    font-size: 0.85rem; color: var(--ink-muted); margin: 0.2rem 0 0.5rem;
  }

  .home-faq-list { margin-top: 0.75rem; max-width: 58ch; }
  .home-faq-list dt {
    font-weight: 700; color: var(--accent-deep); margin-top: 1.1rem;
    font-family: 'Fraunces', Georgia, serif; font-size: 1.02rem;
  }
  .home-faq-list dt:first-child { margin-top: 0; }
  .home-faq-list dd {
    margin: 0.35rem 0 0; color: var(--ink-muted); font-size: 0.98rem; line-height: 1.6;
  }

  .home-contact {
    display: flex; flex-wrap: wrap; gap: 1.25rem;
    align-items: center; justify-content: space-between;
    padding: 1.5rem; border: 1px solid var(--border); border-radius: 10px;
    background: var(--surface-raised);
  }
  .home-contact-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
